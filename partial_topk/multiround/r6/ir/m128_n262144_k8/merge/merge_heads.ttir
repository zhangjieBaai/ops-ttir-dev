    tt.store %h5_vp, %h5_value : !tt.ptr<f32>
    tt.store %h5_op, %h5_bestid : !tt.ptr<i32>

    %h5_idvec = tt.splat %h5_bestid : i32 -> tensor<256xi32>
    %h5_chosen = arith.cmpi eq, %h4_ids, %h5_idvec : tensor<256xi32>
    %h5_advance = arith.select %h5_chosen, %one, %izero : tensor<256xi1>, tensor<256xi32>
    %h5_cursor = arith.addi %h4_cursor, %h5_advance : tensor<256xi32>
    %h5_remains = arith.cmpi slt, %h5_cursor, %kvec : tensor<256xi32>
    %h5_valid = arith.andi %validchunk, %h5_remains : tensor<256xi1>
    %h5_read = arith.andi %h5_chosen, %h5_valid : tensor<256xi1>
    %h5_offset = arith.addi %offsets, %h5_cursor : tensor<256xi32>
    %h5_xp = tt.addptr %xvec, %h5_offset : tensor<256x!tt.ptr<f32>>, tensor<256xi32>
    %h5_ip = tt.addptr %ivec, %h5_offset : tensor<256x!tt.ptr<i32>>, tensor<256xi32>
    %h5_loaded = tt.load %h5_xp, %h5_read, %neginf : tensor<256x!tt.ptr<f32>>
    %h5_loadedid = tt.load %h5_ip, %h5_read, %intmax : tensor<256x!tt.ptr<i32>>
    %h5_ids = arith.select %h5_chosen, %h5_loadedid, %h4_ids : tensor<256xi1>, tensor<256xi32>

    %h5_iszero = arith.cmpf oeq, %h5_loaded, %zero : tensor<256xf32>
    %h5_normal = arith.select %h5_iszero, %zero, %h5_loaded : tensor<256xi1>, tensor<256xf32>
    %h5_bits = tt.bitcast %h5_normal : tensor<256xf32> -> tensor<256xi32>
    %h5_sign = arith.shrsi %h5_bits, %shift31 : tensor<256xi32>
    %h5_flip = arith.ori %h5_sign, %signbit : tensor<256xi32>
    %h5_keys = arith.xori %h5_bits, %h5_flip : tensor<256xi32>

    %h5_state = arith.select %h5_chosen, %h5_keys, %h4_state : tensor<256xi1>, tensor<256xi32>
    %h6_maximum = "tt.reduce"(%h5_state) <{axis = 0 : i32}> ({
    ^bb0(%h6_a: i32, %h6_b: i32):
      %h6_m = arith.maxui %h6_a, %h6_b : i32
      tt.reduce.return %h6_m : i32
    }) : (tensor<256xi32>) -> i32

    %h6_maxvec = tt.splat %h6_maximum : i32 -> tensor<256xi32>
    %h6_match = arith.cmpi eq, %h5_state, %h6_maxvec : tensor<256xi32>
    %h6_choices = arith.select %h6_match, %h5_ids, %intmax : tensor<256xi1>, tensor<256xi32>
    %h6_bestid = "tt.reduce"(%h6_choices) <{axis = 0 : i32}> ({
    ^bb0(%h6_ia: i32, %h6_ib: i32):
      %h6_im = arith.minsi %h6_ia, %h6_ib : i32
      tt.reduce.return %h6_im : i32
    }) : (tensor<256xi32>) -> i32

    %h6_positive = arith.cmpi slt, %h6_maximum, %szero : i32
    %h6_undo = arith.select %h6_positive, %ssign, %sall : i32
    %h6_valuebits = arith.xori %h6_maximum, %h6_undo : i32
    %h6_value = tt.bitcast %h6_valuebits : i32 -> f32
    %h6_outidx = arith.constant 6 : i32
    %h6_vp = tt.addptr %vbase, %h6_outidx : !tt.ptr<f32>, i32
    %h6_op = tt.addptr %obase, %h6_outidx : !tt.ptr<i32>, i32
    tt.store %h6_vp, %h6_value : !tt.ptr<f32>
    tt.store %h6_op, %h6_bestid : !tt.ptr<i32>

    %h6_idvec = tt.splat %h6_bestid : i32 -> tensor<256xi32>
    %h6_chosen = arith.cmpi eq, %h5_ids, %h6_idvec : tensor<256xi32>
    %h6_advance = arith.select %h6_chosen, %one, %izero : tensor<256xi1>, tensor<256xi32>
    %h6_cursor = arith.addi %h5_cursor, %h6_advance : tensor<256xi32>
    %h6_remains = arith.cmpi slt, %h6_cursor, %kvec : tensor<256xi32>
    %h6_valid = arith.andi %validchunk, %h6_remains : tensor<256xi1>
    %h6_read = arith.andi %h6_chosen, %h6_valid : tensor<256xi1>
    %h6_offset = arith.addi %offsets, %h6_cursor : tensor<256xi32>
    %h6_xp = tt.addptr %xvec, %h6_offset : tensor<256x!tt.ptr<f32>>, tensor<256xi32>
    %h6_ip = tt.addptr %ivec, %h6_offset : tensor<256x!tt.ptr<i32>>, tensor<256xi32>
    %h6_loaded = tt.load %h6_xp, %h6_read, %neginf : tensor<256x!tt.ptr<f32>>
    %h6_loadedid = tt.load %h6_ip, %h6_read, %intmax : tensor<256x!tt.ptr<i32>>
    %h6_ids = arith.select %h6_chosen, %h6_loadedid, %h5_ids : tensor<256xi1>, tensor<256xi32>

    %h6_iszero = arith.cmpf oeq, %h6_loaded, %zero : tensor<256xf32>
    %h6_normal = arith.select %h6_iszero, %zero, %h6_loaded : tensor<256xi1>, tensor<256xf32>
    %h6_bits = tt.bitcast %h6_normal : tensor<256xf32> -> tensor<256xi32>
    %h6_sign = arith.shrsi %h6_bits, %shift31 : tensor<256xi32>
    %h6_flip = arith.ori %h6_sign, %signbit : tensor<256xi32>
    %h6_keys = arith.xori %h6_bits, %h6_flip : tensor<256xi32>

    %h6_state = arith.select %h6_chosen, %h6_keys, %h5_state : tensor<256xi1>, tensor<256xi32>
    %h7_maximum = "tt.reduce"(%h6_state) <{axis = 0 : i32}> ({
    ^bb0(%h7_a: i32, %h7_b: i32):
      %h7_m = arith.maxui %h7_a, %h7_b : i32
      tt.reduce.return %h7_m : i32
    }) : (tensor<256xi32>) -> i32

    %h7_maxvec = tt.splat %h7_maximum : i32 -> tensor<256xi32>
    %h7_match = arith.cmpi eq, %h6_state, %h7_maxvec : tensor<256xi32>
    %h7_choices = arith.select %h7_match, %h6_ids, %intmax : tensor<256xi1>, tensor<256xi32>
    %h7_bestid = "tt.reduce"(%h7_choices) <{axis = 0 : i32}> ({
    ^bb0(%h7_ia: i32, %h7_ib: i32):
      %h7_im = arith.minsi %h7_ia, %h7_ib : i32
      tt.reduce.return %h7_im : i32
    }) : (tensor<256xi32>) -> i32

    %h7_positive = arith.cmpi slt, %h7_maximum, %szero : i32
    %h7_undo = arith.select %h7_positive, %ssign, %sall : i32
    %h7_valuebits = arith.xori %h7_maximum, %h7_undo : i32
    %h7_value = tt.bitcast %h7_valuebits : i32 -> f32
    %h7_outidx = arith.constant 7 : i32
    %h7_vp = tt.addptr %vbase, %h7_outidx : !tt.ptr<f32>, i32
    %h7_op = tt.addptr %obase, %h7_outidx : !tt.ptr<i32>, i32
    tt.store %h7_vp, %h7_value : !tt.ptr<f32>
    tt.store %h7_op, %h7_bestid : !tt.ptr<i32>

    tt.return
  }
}
