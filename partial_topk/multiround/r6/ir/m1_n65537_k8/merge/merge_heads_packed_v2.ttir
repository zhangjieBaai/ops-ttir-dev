      tt.reduce.return %h5_m : i64
    }) : (tensor<128xi64>) -> i64

    %h5_high = arith.shrui %h5_maximum, %shift32 : i64
    %h5_maxkey = arith.trunci %h5_high : i64 to i32
    %h5_low = arith.trunci %h5_maximum : i64 to i32
    %h5_bestid = arith.subi %smax, %h5_low : i32

    %h5_positive = arith.cmpi slt, %h5_maxkey, %szero : i32
    %h5_undo = arith.select %h5_positive, %ssign, %sall : i32
    %h5_valuebits = arith.xori %h5_maxkey, %h5_undo : i32
    %h5_value = tt.bitcast %h5_valuebits : i32 -> f32
    %h5_outidx = arith.constant 5 : i32
    %h5_vp = tt.addptr %vbase, %h5_outidx : !tt.ptr<f32>, i32
    %h5_op = tt.addptr %obase, %h5_outidx : !tt.ptr<i32>, i32
    tt.store %h5_vp, %h5_value : !tt.ptr<f32>
    tt.store %h5_op, %h5_bestid : !tt.ptr<i32>

    %h5_idvec = tt.splat %h5_bestid : i32 -> tensor<128xi32>
    %h5_chosen = arith.cmpi eq, %h4_ids, %h5_idvec : tensor<128xi32>
    %h5_advance = arith.select %h5_chosen, %one, %izero : tensor<128xi1>, tensor<128xi32>
    %h5_cursor = arith.addi %h4_cursor, %h5_advance : tensor<128xi32>
    %h5_remains = arith.cmpi slt, %h5_cursor, %kvec : tensor<128xi32>
    %h5_valid = arith.andi %validchunk, %h5_remains : tensor<128xi1>
    %h5_read = arith.andi %h5_chosen, %h5_valid : tensor<128xi1>
    %h5_offset = arith.addi %offsets, %h5_cursor : tensor<128xi32>
    %h5_xp = tt.addptr %xvec, %h5_offset : tensor<128x!tt.ptr<f32>>, tensor<128xi32>
    %h5_ip = tt.addptr %ivec, %h5_offset : tensor<128x!tt.ptr<i32>>, tensor<128xi32>
    %h5_loaded = tt.load %h5_xp, %h5_read, %neginf : tensor<128x!tt.ptr<f32>>
    %h5_loadedid = tt.load %h5_ip, %h5_read, %intmax : tensor<128x!tt.ptr<i32>>
    %h5_ids = arith.select %h5_chosen, %h5_loadedid, %h4_ids : tensor<128xi1>, tensor<128xi32>

    %h5_iszero = arith.cmpf oeq, %h5_loaded, %zero : tensor<128xf32>
    %h5_normal = arith.select %h5_iszero, %zero, %h5_loaded : tensor<128xi1>, tensor<128xf32>
    %h5_bits = tt.bitcast %h5_normal : tensor<128xf32> -> tensor<128xi32>
    %h5_sign = arith.shrsi %h5_bits, %shift31 : tensor<128xi32>
    %h5_flip = arith.ori %h5_sign, %signbit : tensor<128xi32>
    %h5_keys = arith.xori %h5_bits, %h5_flip : tensor<128xi32>

    %h5_next_reverse = arith.subi %intmax, %h5_loadedid : tensor<128xi32>
    %h5_next_high = arith.extui %h5_keys : tensor<128xi32> to tensor<128xi64>
    %h5_next_low = arith.extui %h5_next_reverse : tensor<128xi32> to tensor<128xi64>
    %h5_next_shifted = arith.shli %h5_next_high, %shift32v : tensor<128xi64>
    %h5_next_packed = arith.ori %h5_next_shifted, %h5_next_low : tensor<128xi64>

    %h5_state = arith.select %h5_chosen, %h5_next_packed, %h4_state : tensor<128xi1>, tensor<128xi64>
    %h6_maximum = "tt.reduce"(%h5_state) <{axis = 0 : i32}> ({
    ^bb0(%h6_a: i64, %h6_b: i64):
      %h6_m = arith.maxui %h6_a, %h6_b : i64
      tt.reduce.return %h6_m : i64
    }) : (tensor<128xi64>) -> i64

    %h6_high = arith.shrui %h6_maximum, %shift32 : i64
    %h6_maxkey = arith.trunci %h6_high : i64 to i32
    %h6_low = arith.trunci %h6_maximum : i64 to i32
    %h6_bestid = arith.subi %smax, %h6_low : i32

    %h6_positive = arith.cmpi slt, %h6_maxkey, %szero : i32
    %h6_undo = arith.select %h6_positive, %ssign, %sall : i32
    %h6_valuebits = arith.xori %h6_maxkey, %h6_undo : i32
    %h6_value = tt.bitcast %h6_valuebits : i32 -> f32
    %h6_outidx = arith.constant 6 : i32
    %h6_vp = tt.addptr %vbase, %h6_outidx : !tt.ptr<f32>, i32
    %h6_op = tt.addptr %obase, %h6_outidx : !tt.ptr<i32>, i32
    tt.store %h6_vp, %h6_value : !tt.ptr<f32>
    tt.store %h6_op, %h6_bestid : !tt.ptr<i32>

    %h6_idvec = tt.splat %h6_bestid : i32 -> tensor<128xi32>
    %h6_chosen = arith.cmpi eq, %h5_ids, %h6_idvec : tensor<128xi32>
    %h6_advance = arith.select %h6_chosen, %one, %izero : tensor<128xi1>, tensor<128xi32>
    %h6_cursor = arith.addi %h5_cursor, %h6_advance : tensor<128xi32>
    %h6_remains = arith.cmpi slt, %h6_cursor, %kvec : tensor<128xi32>
    %h6_valid = arith.andi %validchunk, %h6_remains : tensor<128xi1>
    %h6_read = arith.andi %h6_chosen, %h6_valid : tensor<128xi1>
    %h6_offset = arith.addi %offsets, %h6_cursor : tensor<128xi32>
    %h6_xp = tt.addptr %xvec, %h6_offset : tensor<128x!tt.ptr<f32>>, tensor<128xi32>
    %h6_ip = tt.addptr %ivec, %h6_offset : tensor<128x!tt.ptr<i32>>, tensor<128xi32>
    %h6_loaded = tt.load %h6_xp, %h6_read, %neginf : tensor<128x!tt.ptr<f32>>
    %h6_loadedid = tt.load %h6_ip, %h6_read, %intmax : tensor<128x!tt.ptr<i32>>
    %h6_ids = arith.select %h6_chosen, %h6_loadedid, %h5_ids : tensor<128xi1>, tensor<128xi32>

    %h6_iszero = arith.cmpf oeq, %h6_loaded, %zero : tensor<128xf32>
    %h6_normal = arith.select %h6_iszero, %zero, %h6_loaded : tensor<128xi1>, tensor<128xf32>
    %h6_bits = tt.bitcast %h6_normal : tensor<128xf32> -> tensor<128xi32>
    %h6_sign = arith.shrsi %h6_bits, %shift31 : tensor<128xi32>
    %h6_flip = arith.ori %h6_sign, %signbit : tensor<128xi32>
    %h6_keys = arith.xori %h6_bits, %h6_flip : tensor<128xi32>

    %h6_next_reverse = arith.subi %intmax, %h6_loadedid : tensor<128xi32>
    %h6_next_high = arith.extui %h6_keys : tensor<128xi32> to tensor<128xi64>
    %h6_next_low = arith.extui %h6_next_reverse : tensor<128xi32> to tensor<128xi64>
    %h6_next_shifted = arith.shli %h6_next_high, %shift32v : tensor<128xi64>
    %h6_next_packed = arith.ori %h6_next_shifted, %h6_next_low : tensor<128xi64>

    %h6_state = arith.select %h6_chosen, %h6_next_packed, %h5_state : tensor<128xi1>, tensor<128xi64>
    %h7_maximum = "tt.reduce"(%h6_state) <{axis = 0 : i32}> ({
    ^bb0(%h7_a: i64, %h7_b: i64):
      %h7_m = arith.maxui %h7_a, %h7_b : i64
      tt.reduce.return %h7_m : i64
    }) : (tensor<128xi64>) -> i64

    %h7_high = arith.shrui %h7_maximum, %shift32 : i64
    %h7_maxkey = arith.trunci %h7_high : i64 to i32
    %h7_low = arith.trunci %h7_maximum : i64 to i32
    %h7_bestid = arith.subi %smax, %h7_low : i32

    %h7_positive = arith.cmpi slt, %h7_maxkey, %szero : i32
    %h7_undo = arith.select %h7_positive, %ssign, %sall : i32
    %h7_valuebits = arith.xori %h7_maxkey, %h7_undo : i32
    %h7_value = tt.bitcast %h7_valuebits : i32 -> f32
    %h7_outidx = arith.constant 7 : i32
    %h7_vp = tt.addptr %vbase, %h7_outidx : !tt.ptr<f32>, i32
    %h7_op = tt.addptr %obase, %h7_outidx : !tt.ptr<i32>, i32
    tt.store %h7_vp, %h7_value : !tt.ptr<f32>
    tt.store %h7_op, %h7_bestid : !tt.ptr<i32>

    tt.return
  }
}
