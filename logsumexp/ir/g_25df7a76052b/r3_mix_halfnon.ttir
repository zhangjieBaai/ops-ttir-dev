    %mask_13 = arith.cmpi slt, %n_offsets_2, %mask : tensor<8192x1xi32>
    %mask_14 = arith.cmpi slt, %pid_k_1, %inp_offset_4 : i64
    %mask_15 = tt.splat %mask_14 : i1 -> tensor<8192x1xi1>
    %mask_16 = arith.andi %mask_13, %mask_15 : tensor<8192x1xi1>
    %input_ptrs = tt.splat %input_ptr : !tt.ptr<f16> -> tensor<8192x1x!tt.ptr<f16>>
    %input_ptrs_17 = tt.addptr %input_ptrs, %inp_offset_12 : tensor<8192x1x!tt.ptr<f16>>, tensor<8192x1xi64>
    %inp_18 = tt.load %input_ptrs_17, %mask_16, %inp : tensor<8192x1x!tt.ptr<f16>>
    %m_half = "tt.reduce"(%inp_18) <{axis = 0 : i32}> ({
    ^bb0(%m_30: f16, %m_31: f16):
      %m_32 = arith.maxnumf %m_30, %m_31 : f16
      tt.reduce.return %m_32 : f16
    }) : (tensor<8192x1xf16>) -> tensor<1xf16>
    %m = arith.extf %m_half : tensor<1xf16> to tensor<1xf32>
    %inp_19 = arith.extf %inp_18 : tensor<8192x1xf16> to tensor<8192x1xf32>
    %m_20 = tt.expand_dims %m {axis = 0 : i32} : tensor<1xf32> -> tensor<1x1xf32>
    %safe_m_21 = arith.cmpf oeq, %m_20, %cst : tensor<1x1xf32>
    %safe_m_22 = arith.select %safe_m_21, %safe_m, %m_20 : tensor<1x1xi1>, tensor<1x1xf32>
    %e = tt.broadcast %safe_m_22 : tensor<1x1xf32> -> tensor<8192x1xf32>
    %e_23 = arith.subf %inp_19, %e : tensor<8192x1xf32>
    %e_24 = math.exp %e_23 : tensor<8192x1xf32>
    %z = "tt.reduce"(%e_24) <{axis = 0 : i32}> ({
    ^bb0(%z_30: f32, %z_31: f32):
      %z_32 = arith.addf %z_30, %z_31 : f32
      tt.reduce.return %z_32 : f32
    }) : (tensor<8192x1xf32>) -> tensor<1xf32>
    %z_25 = tt.expand_dims %z {axis = 0 : i32} : tensor<1xf32> -> tensor<1x1xf32>
    %out = math.log %z_25 : tensor<1x1xf32>
    %out_26 = arith.addf %safe_m_22, %out : tensor<1x1xf32>
    %out_27 = arith.select %safe_m_21, %m_20, %out_26 : tensor<1x1xi1>, tensor<1x1xf32>
    %out_offset = arith.muli %pid_m_0, %inp_offset_4 : i64
    %out_offset_28 = arith.addi %out_offset, %pid_k_1 : i64
    %output_ptrs = tt.addptr %output_ptr, %out_offset_28 : !tt.ptr<f16>, i64
    %output_ptrs_29 = tt.splat %output_ptrs : !tt.ptr<f16> -> tensor<1x1x!tt.ptr<f16>>
    %0 = tt.splat %mask_14 : i1 -> tensor<1x1xi1>
    %1 = arith.truncf %out_27 : tensor<1x1xf32> to tensor<1x1xf16>
    tt.store %output_ptrs_29, %1, %0 : tensor<1x1x!tt.ptr<f16>>
    }
    }
    }
    }
    tt.return
  }
}
