module {
  tt.func public @logsumexp_kernel_inner(%output_ptr: !tt.ptr<f16> {tt.divisibility = 16 : i32}, %input_ptr: !tt.ptr<f16> {tt.divisibility = 16 : i32}, %M: i32, %N: i32 {tt.divisibility = 16 : i32}) attributes {noinline = false} {
    %inp = arith.constant dense<0xFC00> : tensor<4096xf16>
    %cst = arith.constant 0.000000e+00 : f32
    %cst_0 = arith.constant 0xFF800000 : f32
    %pid_m = tt.get_program_id x : i32
    %n_offsets = tt.make_range {end = 4096 : i32, start = 0 : i32} : tensor<4096xi32>
    %offset_2 = arith.muli %pid_m, %N : i32
    %offset_4 = tt.splat %offset_2 : i32 -> tensor<4096xi32>
    %offset_5 = arith.addi %offset_4, %n_offsets : tensor<4096xi32>
    %input_ptrs = tt.splat %input_ptr : !tt.ptr<f16> -> tensor<4096x!tt.ptr<f16>>
    %input_ptrs_6 = tt.addptr %input_ptrs, %offset_5 : tensor<4096x!tt.ptr<f16>>, tensor<4096xi32>
    %mask = tt.splat %N : i32 -> tensor<4096xi32>
    %mask_7 = arith.cmpi slt, %n_offsets, %mask : tensor<4096xi32>
    %inp_8 = tt.load %input_ptrs_6, %mask_7, %inp : tensor<4096x!tt.ptr<f16>>
    %inp_9 = arith.extf %inp_8 : tensor<4096xf16> to tensor<4096xf32>
    %m = "tt.reduce"(%inp_9) <{axis = 0 : i32}> ({
    ^bb0(%m_15: f32, %m_16: f32):
      %m_17 = arith.maxnumf %m_15, %m_16 : f32
      tt.reduce.return %m_17 : f32
    }) : (tensor<4096xf32>) -> f32
    %safe_m = arith.cmpf oeq, %m, %cst_0 : f32
    %safe_m_10 = arith.select %safe_m, %cst, %m : f32
    %e = tt.splat %safe_m_10 : f32 -> tensor<4096xf32>
    %e_11 = arith.subf %inp_9, %e : tensor<4096xf32>
    %e_12 = math.exp %e_11 : tensor<4096xf32>
    %z = "tt.reduce"(%e_12) <{axis = 0 : i32}> ({
    ^bb0(%z_15: f32, %z_16: f32):
      %z_17 = arith.addf %z_15, %z_16 : f32
      tt.reduce.return %z_17 : f32
    }) : (tensor<4096xf32>) -> f32
    %out = math.log %z : f32
    %out_13 = arith.addf %safe_m_10, %out : f32
    %out_14 = arith.select %safe_m, %m, %out_13 : f32
    %output_ptrs = tt.addptr %output_ptr, %pid_m : !tt.ptr<f16>, i32
    %0 = arith.truncf %out_14 : f32 to f16
    tt.store %output_ptrs, %0 : !tt.ptr<f16>
    tt.return
  }
}
