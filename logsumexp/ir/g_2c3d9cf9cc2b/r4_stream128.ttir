    %sum17 = arith.addf %exp17, %sum16 : tensor<128xf32>
    %xf18 = arith.extf %x18 : tensor<128xf16> to tensor<128xf32>
    %delta18 = arith.subf %xf18, %r4_bmax : tensor<128xf32>
    %exp18 = math.exp %delta18 : tensor<128xf32>
    %sum18 = arith.addf %exp18, %sum17 : tensor<128xf32>
    %xf19 = arith.extf %x19 : tensor<128xf16> to tensor<128xf32>
    %delta19 = arith.subf %xf19, %r4_bmax : tensor<128xf32>
    %exp19 = math.exp %delta19 : tensor<128xf32>
    %sum19 = arith.addf %exp19, %sum18 : tensor<128xf32>
    %xf20 = arith.extf %x20 : tensor<128xf16> to tensor<128xf32>
    %delta20 = arith.subf %xf20, %r4_bmax : tensor<128xf32>
    %exp20 = math.exp %delta20 : tensor<128xf32>
    %sum20 = arith.addf %exp20, %sum19 : tensor<128xf32>
    %xf21 = arith.extf %x21 : tensor<128xf16> to tensor<128xf32>
    %delta21 = arith.subf %xf21, %r4_bmax : tensor<128xf32>
    %exp21 = math.exp %delta21 : tensor<128xf32>
    %sum21 = arith.addf %exp21, %sum20 : tensor<128xf32>
    %xf22 = arith.extf %x22 : tensor<128xf16> to tensor<128xf32>
    %delta22 = arith.subf %xf22, %r4_bmax : tensor<128xf32>
    %exp22 = math.exp %delta22 : tensor<128xf32>
    %sum22 = arith.addf %exp22, %sum21 : tensor<128xf32>
    %xf23 = arith.extf %x23 : tensor<128xf16> to tensor<128xf32>
    %delta23 = arith.subf %xf23, %r4_bmax : tensor<128xf32>
    %exp23 = math.exp %delta23 : tensor<128xf32>
    %sum23 = arith.addf %exp23, %sum22 : tensor<128xf32>
    %xf24 = arith.extf %x24 : tensor<128xf16> to tensor<128xf32>
    %delta24 = arith.subf %xf24, %r4_bmax : tensor<128xf32>
    %exp24 = math.exp %delta24 : tensor<128xf32>
    %sum24 = arith.addf %exp24, %sum23 : tensor<128xf32>
    %xf25 = arith.extf %x25 : tensor<128xf16> to tensor<128xf32>
    %delta25 = arith.subf %xf25, %r4_bmax : tensor<128xf32>
    %exp25 = math.exp %delta25 : tensor<128xf32>
    %sum25 = arith.addf %exp25, %sum24 : tensor<128xf32>
    %xf26 = arith.extf %x26 : tensor<128xf16> to tensor<128xf32>
    %delta26 = arith.subf %xf26, %r4_bmax : tensor<128xf32>
    %exp26 = math.exp %delta26 : tensor<128xf32>
    %sum26 = arith.addf %exp26, %sum25 : tensor<128xf32>
    %xf27 = arith.extf %x27 : tensor<128xf16> to tensor<128xf32>
    %delta27 = arith.subf %xf27, %r4_bmax : tensor<128xf32>
    %exp27 = math.exp %delta27 : tensor<128xf32>
    %sum27 = arith.addf %exp27, %sum26 : tensor<128xf32>
    %xf28 = arith.extf %x28 : tensor<128xf16> to tensor<128xf32>
    %delta28 = arith.subf %xf28, %r4_bmax : tensor<128xf32>
    %exp28 = math.exp %delta28 : tensor<128xf32>
    %sum28 = arith.addf %exp28, %sum27 : tensor<128xf32>
    %xf29 = arith.extf %x29 : tensor<128xf16> to tensor<128xf32>
    %delta29 = arith.subf %xf29, %r4_bmax : tensor<128xf32>
    %exp29 = math.exp %delta29 : tensor<128xf32>
    %sum29 = arith.addf %exp29, %sum28 : tensor<128xf32>
    %xf30 = arith.extf %x30 : tensor<128xf16> to tensor<128xf32>
    %delta30 = arith.subf %xf30, %r4_bmax : tensor<128xf32>
    %exp30 = math.exp %delta30 : tensor<128xf32>
    %sum30 = arith.addf %exp30, %sum29 : tensor<128xf32>
    %xf31 = arith.extf %x31 : tensor<128xf16> to tensor<128xf32>
    %delta31 = arith.subf %xf31, %r4_bmax : tensor<128xf32>
    %exp31 = math.exp %delta31 : tensor<128xf32>
    %sum31 = arith.addf %exp31, %sum30 : tensor<128xf32>
    %r4_sum = "tt.reduce"(%sum127) <{axis = 0 : i32}> ({
    ^bb0(%a: f32, %b: f32):
      %s = arith.addf %a, %b : f32
      tt.reduce.return %s : f32
    }) : (tensor<128xf32>) -> f32
    %r4_log = math.log %r4_sum : f32
    %r4_val = arith.addf %r4_safe, %r4_log : f32
    %r4_out = arith.select %r4_allinf, %r4_max, %r4_val : f32
    %r4_y16 = arith.truncf %r4_out : f32 to f16
    tt.store %output_ptr, %r4_y16 : !tt.ptr<f16>
    tt.return
  }
}
