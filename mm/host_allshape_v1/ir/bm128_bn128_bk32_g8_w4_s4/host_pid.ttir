module {
  tt.func public @matmul_kernel(%ad: !tt.tensordesc<tensor<128x32xf16>>, %ad_s0: i32, %ad_s1: i32, %ad_st0: i64, %ad_st1: i64, %bd: !tt.tensordesc<tensor<32x128xf16>>, %bd_s0: i32, %bd_s1: i32, %bd_st0: i64, %bd_st1: i64, %cd: !tt.tensordesc<tensor<128x128xf16>>, %cd_s0: i32, %cd_s1: i32, %cd_st0: i64, %cd_st1: i64, %a_ptr: !tt.ptr<f16> {tt.divisibility = 16 : i32}, %b_ptr: !tt.ptr<f16> {tt.divisibility = 16 : i32}, %c_ptr: !tt.ptr<f16> {tt.divisibility = 16 : i32}, %M: i32 {tt.divisibility = 16 : i32}, %N: i32 {tt.divisibility = 16 : i32}, %K: i32 {tt.divisibility = 16 : i32}, %stride_am: i32 {tt.divisibility = 16 : i32}, %stride_bk: i32 {tt.divisibility = 16 : i32}, %stride_cm: i32 {tt.divisibility = 16 : i32}) attributes {noinline = false} {
    %c0 = arith.constant 0 : i32
    %c1 = arith.constant 1 : i32
    %g = arith.constant 8 : i32
    %bm = arith.constant 128 : i32
    %bn = arith.constant 128 : i32
    %bk = arith.constant 32 : i32
    %bm1 = arith.constant 127 : i32
    %bn1 = arith.constant 127 : i32
    %bk1 = arith.constant 31 : i32
    %pid = tt.get_program_id x : i32
    %madd = arith.addi %M, %bm1 : i32
    %nm = arith.divsi %madd, %bm : i32
    %nadd = arith.addi %N, %bn1 : i32
    %nn = arith.divsi %nadd, %bn : i32
    %width = arith.muli %nn, %g : i32
    %group = arith.divsi %pid, %width : i32
    %first = arith.muli %group, %g : i32
    %remaining = arith.subi %nm, %first : i32
    %size = arith.minsi %remaining, %g : i32
    %local = arith.remsi %pid, %width : i32
    %rm = arith.remsi %pid, %size : i32
    %pm = arith.addi %first, %rm : i32
    %pn = arith.divsi %local, %size : i32
    %om = arith.muli %pm, %bm : i32
    %on = arith.muli %pn, %bn : i32
    %kadd = arith.addi %K, %bk1 : i32
    %iters = arith.divsi %kadd, %bk : i32
    %zero = arith.constant dense<0.0> : tensor<128x128xf32>
    %result = scf.for %k = %c0 to %iters step %c1 iter_args(%acc = %zero) -> (tensor<128x128xf32>) : i32 {
      %ok = arith.muli %k, %bk : i32
      %a = tt.descriptor_load %ad[%om, %ok] : !tt.tensordesc<tensor<128x32xf16>> -> tensor<128x32xf16>
      %b = tt.descriptor_load %bd[%ok, %on] : !tt.tensordesc<tensor<32x128xf16>> -> tensor<32x128xf16>
      %next = tt.dot %a, %b, %acc, inputPrecision = tf32 : tensor<128x32xf16> * tensor<32x128xf16> -> tensor<128x128xf32>
      scf.yield %next : tensor<128x128xf32>
    }
    %out = arith.truncf %result : tensor<128x128xf32> to tensor<128x128xf16>
    tt.descriptor_store %cd[%om, %on], %out : !tt.tensordesc<tensor<128x128xf16>>, tensor<128x128xf16>
    tt.return
  }
}
