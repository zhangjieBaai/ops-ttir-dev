      %a_57 = tt.load %a_ptrs_50, %a_56, %cst_0 : tensor<128x64x!tt.ptr<f16>>
      %b = tt.splat %a_53 : i32 -> tensor<64x1xi32>
      %b_58 = arith.cmpi slt, %b_ptrs, %b : tensor<64x1xi32>
      %b_59 = tt.broadcast %b_58 : tensor<64x1xi1> -> tensor<64x256xi1>
      %b_60 = tt.load %b_ptrs_51, %b_59, %cst : tensor<64x256x!tt.ptr<f16>>
      %accumulator_61 = tt.dot %a_57, %b_60, %accumulator_52, inputPrecision = tf32 : tensor<128x64xf16> * tensor<64x256xf16> -> tensor<128x256xf32>
      %a_ptrs_62 = tt.addptr %a_ptrs_50, %cst_1 : tensor<128x64x!tt.ptr<f16>>, tensor<128x64xi32>
      %b_ptrs_63 = arith.muli %stride_bk, %c64_i32 : i32
      %b_ptrs_64 = tt.splat %b_ptrs_63 : i32 -> tensor<64x256xi32>
      %b_ptrs_65 = tt.addptr %b_ptrs_51, %b_ptrs_64 : tensor<64x256x!tt.ptr<f16>>, tensor<64x256xi32>
      scf.yield %a_ptrs_62, %b_ptrs_65, %accumulator_61 : tensor<128x64x!tt.ptr<f16>>, tensor<64x256x!tt.ptr<f16>>, tensor<128x256xf32>
    }
    %c = arith.truncf %accumulator_35#2 : tensor<128x256xf32> to tensor<128x256xf16>
    %c_ptrs = tt.expand_dims %offs_am_11 {axis = 1 : i32} : tensor<128xi32> -> tensor<128x1xi32>
    %c_ptrs_36 = tt.splat %stride_cm : i32 -> tensor<128x1xi32>
