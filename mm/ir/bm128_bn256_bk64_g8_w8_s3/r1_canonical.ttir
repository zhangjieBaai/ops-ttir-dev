    %5 = arith.addi %K, %c63_i32 : i32
    %6 = arith.divsi %5, %c64_i32 : i32
    %accumulator_35:3 = scf.for %k = %c0_i32 to %6 step %c1_i32 iter_args(%a_ptrs_50 = %a_ptrs_26, %b_ptrs_51 = %b_ptrs_34, %accumulator_52 = %accumulator) -> (tensor<128x64x!tt.ptr<f16>>, tensor<64x256x!tt.ptr<f16>>, tensor<128x256xf32>)  : i32 {
