module {
  tt.func public @matmul_kernel(%a_ptr: !tt.ptr<f16> {tt.divisibility = 16 : i32}, %b_ptr: !tt.ptr<f16> {tt.divisibility = 16 : i32}, %c_ptr: !tt.ptr<f16> {tt.divisibility = 16 : i32}, %M: i32 {tt.divisibility = 16 : i32}, %N: i32 {tt.divisibility = 16 : i32}, %K: i32 {tt.divisibility = 16 : i32}, %stride_am: i32 {tt.divisibility = 16 : i32}, %stride_bk: i32 {tt.divisibility = 16 : i32}, %stride_cm: i32 {tt.divisibility = 16 : i32}) attributes {noinline = false} {
    %c31_i32 = arith.constant 31 : i32
    %accumulator = arith.constant dense<0.000000e+00> : tensor<128x128xf32>
    %c127_i32 = arith.constant 127 : i32
    %cst = arith.constant dense<0.000000e+00> : tensor<32x128xf16>
    %cst_0 = arith.constant dense<0.000000e+00> : tensor<128x32xf16>
    %c1_i32 = arith.constant 1 : i32
    %cst_1 = arith.constant dense<32> : tensor<128x32xi32>
    %c32_i32 = arith.constant 32 : i32
    %c128_i32 = arith.constant 128 : i32
    %true = arith.constant true
    %c0_i32 = arith.constant 0 : i32
    %c8_i32 = arith.constant 8 : i32
    %pid = tt.get_program_id x : i32
    %num_pid_m = arith.addi %M, %c127_i32 : i32
    %num_pid_m_2 = arith.divsi %num_pid_m, %c128_i32 : i32
    %num_pid_n = arith.addi %N, %c127_i32 : i32
    %num_pid_n_3 = arith.divsi %num_pid_n, %c128_i32 : i32
    %num_pid_in_group = arith.muli %num_pid_n_3, %c8_i32 : i32
    %group_id = arith.divsi %pid, %num_pid_in_group : i32
    %first_pid_m = arith.muli %group_id, %c8_i32 : i32
    %group_size_m = arith.subi %num_pid_m_2, %first_pid_m : i32
    %group_size_m_4 = arith.minsi %group_size_m, %c8_i32 : i32
    %pid_m = arith.remsi %pid, %num_pid_in_group : i32
    %pid_m_5 = arith.remsi %pid_m, %group_size_m_4 : i32
    %pid_m_6 = arith.addi %first_pid_m, %pid_m_5 : i32
    %pid_n = arith.divsi %pid_m, %group_size_m_4 : i32
    %0 = arith.cmpi sge, %pid_m_6, %c0_i32 : i32
    llvm.intr.assume %0 : i1
    %1 = arith.cmpi sge, %pid_n, %c0_i32 : i32
    llvm.intr.assume %1 : i1
    %2 = arith.cmpi sgt, %stride_am, %c0_i32 : i32
    llvm.intr.assume %2 : i1
    llvm.intr.assume %true : i1
    llvm.intr.assume %true : i1
    %3 = arith.cmpi sgt, %stride_bk, %c0_i32 : i32
    llvm.intr.assume %3 : i1
    %4 = arith.cmpi sgt, %stride_cm, %c0_i32 : i32
    llvm.intr.assume %4 : i1
    llvm.intr.assume %true : i1
    %offs_am = arith.muli %pid_m_6, %c128_i32 : i32
    %offs_am_7 = tt.make_range {end = 128 : i32, start = 0 : i32} : tensor<128xi32>
    %offs_am_8 = tt.splat %offs_am : i32 -> tensor<128xi32>
    %offs_am_9 = arith.addi %offs_am_8, %offs_am_7 : tensor<128xi32>
    %offs_am_10 = tt.splat %M : i32 -> tensor<128xi32>
    %offs_am_11 = arith.remsi %offs_am_9, %offs_am_10 : tensor<128xi32>
    %offs_bn = arith.muli %pid_n, %c128_i32 : i32
    %offs_bn_12 = tt.splat %offs_bn : i32 -> tensor<128xi32>
    %offs_bn_13 = arith.addi %offs_bn_12, %offs_am_7 : tensor<128xi32>
    %offs_bn_14 = tt.splat %N : i32 -> tensor<128xi32>
    %offs_bn_15 = arith.remsi %offs_bn_13, %offs_bn_14 : tensor<128xi32>
    %offs_k = tt.make_range {end = 32 : i32, start = 0 : i32} : tensor<32xi32>
    %a_ptrs = tt.expand_dims %offs_am_11 {axis = 1 : i32} : tensor<128xi32> -> tensor<128x1xi32>
    %a_ptrs_16 = tt.splat %stride_am : i32 -> tensor<128x1xi32>
    %a_ptrs_17 = arith.muli %a_ptrs, %a_ptrs_16 : tensor<128x1xi32>
    %a_ptrs_18 = tt.expand_dims %offs_k {axis = 0 : i32} : tensor<32xi32> -> tensor<1x32xi32>
    %a_ptrs_19 = tt.broadcast %a_ptrs_17 : tensor<128x1xi32> -> tensor<128x32xi32>
    %a_ptrs_20 = tt.broadcast %a_ptrs_18 : tensor<1x32xi32> -> tensor<128x32xi32>
    %a_ptrs_21 = arith.addi %a_ptrs_19, %a_ptrs_20 : tensor<128x32xi32>
    %a_ptrs_22 = tt.splat %a_ptr : !tt.ptr<f16> -> tensor<128x32x!tt.ptr<f16>>
    %a_ptrs_23 = tt.addptr %a_ptrs_22, %a_ptrs_21 : tensor<128x32x!tt.ptr<f16>>, tensor<128x32xi32>
    %b_ptrs = tt.expand_dims %offs_k {axis = 1 : i32} : tensor<32xi32> -> tensor<32x1xi32>
    %b_ptrs_24 = tt.splat %stride_bk : i32 -> tensor<32x1xi32>
    %b_ptrs_25 = arith.muli %b_ptrs, %b_ptrs_24 : tensor<32x1xi32>
    %b_ptrs_26 = tt.expand_dims %offs_bn_15 {axis = 0 : i32} : tensor<128xi32> -> tensor<1x128xi32>
    %b_ptrs_27 = tt.broadcast %b_ptrs_25 : tensor<32x1xi32> -> tensor<32x128xi32>
    %b_ptrs_28 = tt.broadcast %b_ptrs_26 : tensor<1x128xi32> -> tensor<32x128xi32>
    %b_ptrs_29 = arith.addi %b_ptrs_27, %b_ptrs_28 : tensor<32x128xi32>
    %b_ptrs_30 = tt.splat %b_ptr : !tt.ptr<f16> -> tensor<32x128x!tt.ptr<f16>>
    %b_ptrs_31 = tt.addptr %b_ptrs_30, %b_ptrs_29 : tensor<32x128x!tt.ptr<f16>>, tensor<32x128xi32>
    %5 = arith.addi %K, %c31_i32 : i32
    %6 = arith.divsi %5, %c32_i32 : i32
    %accumulator_32:3 = scf.for %k = %c0_i32 to %6 step %c1_i32 iter_args(%a_ptrs_47 = %a_ptrs_23, %b_ptrs_48 = %b_ptrs_31, %accumulator_49 = %accumulator) -> (tensor<128x32x!tt.ptr<f16>>, tensor<32x128x!tt.ptr<f16>>, tensor<128x128xf32>)  : i32 {
      %a = arith.muli %k, %c32_i32 : i32
      %a_50 = arith.subi %K, %a : i32
      %a_51 = tt.splat %a_50 : i32 -> tensor<1x32xi32>
      %a_52 = arith.cmpi slt, %a_ptrs_18, %a_51 : tensor<1x32xi32>
      %a_53 = tt.broadcast %a_52 : tensor<1x32xi1> -> tensor<128x32xi1>
      %a_54 = tt.load %a_ptrs_47, %a_53, %cst_0 : tensor<128x32x!tt.ptr<f16>>
      %b = tt.splat %a_50 : i32 -> tensor<32x1xi32>
      %b_55 = arith.cmpi slt, %b_ptrs, %b : tensor<32x1xi32>
      %b_56 = tt.broadcast %b_55 : tensor<32x1xi1> -> tensor<32x128xi1>
      %b_57 = tt.load %b_ptrs_48, %b_56, %cst : tensor<32x128x!tt.ptr<f16>>
      %accumulator_58 = tt.dot %a_54, %b_57, %accumulator_49, inputPrecision = tf32 : tensor<128x32xf16> * tensor<32x128xf16> -> tensor<128x128xf32>
      %a_ptrs_59 = tt.addptr %a_ptrs_47, %cst_1 : tensor<128x32x!tt.ptr<f16>>, tensor<128x32xi32>
      %b_ptrs_60 = arith.muli %stride_bk, %c32_i32 : i32
      %b_ptrs_61 = tt.splat %b_ptrs_60 : i32 -> tensor<32x128xi32>
      %b_ptrs_62 = tt.addptr %b_ptrs_48, %b_ptrs_61 : tensor<32x128x!tt.ptr<f16>>, tensor<32x128xi32>
      scf.yield %a_ptrs_59, %b_ptrs_62, %accumulator_58 : tensor<128x32x!tt.ptr<f16>>, tensor<32x128x!tt.ptr<f16>>, tensor<128x128xf32>
    }
    %c = arith.truncf %accumulator_32#2 : tensor<128x128xf32> to tensor<128x128xf16>
    %c_ptrs = tt.expand_dims %offs_am_9 {axis = 1 : i32} : tensor<128xi32> -> tensor<128x1xi32>
    %c_ptrs_33 = tt.splat %stride_cm : i32 -> tensor<128x1xi32>
    %c_ptrs_34 = arith.muli %c_ptrs_33, %c_ptrs : tensor<128x1xi32>
    %c_ptrs_35 = tt.splat %c_ptr : !tt.ptr<f16> -> tensor<128x1x!tt.ptr<f16>>
    %c_ptrs_36 = tt.addptr %c_ptrs_35, %c_ptrs_34 : tensor<128x1x!tt.ptr<f16>>, tensor<128x1xi32>
    %c_ptrs_37 = tt.expand_dims %offs_bn_13 {axis = 0 : i32} : tensor<128xi32> -> tensor<1x128xi32>
    %c_ptrs_38 = tt.broadcast %c_ptrs_36 : tensor<128x1x!tt.ptr<f16>> -> tensor<128x128x!tt.ptr<f16>>
    %c_ptrs_39 = tt.broadcast %c_ptrs_37 : tensor<1x128xi32> -> tensor<128x128xi32>
    %c_ptrs_40 = tt.addptr %c_ptrs_38, %c_ptrs_39 : tensor<128x128x!tt.ptr<f16>>, tensor<128x128xi32>
    %c_mask = tt.splat %M : i32 -> tensor<128x1xi32>
    %c_mask_41 = arith.cmpi slt, %c_ptrs, %c_mask : tensor<128x1xi32>
    %c_mask_42 = tt.splat %N : i32 -> tensor<1x128xi32>
    %c_mask_43 = arith.cmpi slt, %c_ptrs_37, %c_mask_42 : tensor<1x128xi32>
    %c_mask_44 = tt.broadcast %c_mask_41 : tensor<128x1xi1> -> tensor<128x128xi1>
    %c_mask_45 = tt.broadcast %c_mask_43 : tensor<1x128xi1> -> tensor<128x128xi1>
    %c_mask_46 = arith.andi %c_mask_44, %c_mask_45 : tensor<128x128xi1>
    tt.store %c_ptrs_40, %c, %c_mask_46 : tensor<128x128x!tt.ptr<f16>>
    tt.return
  }
}
