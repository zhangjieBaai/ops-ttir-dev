#loc1 = loc("output_ptr")
#loc2 = loc("input_ptr")
#loc3 = loc("M")
#loc4 = loc("N")
#loc5 = loc("K")
module {
  tt.func public @mean_dim_kernel_non_inner_vec(%output_ptr: !tt.ptr<f16> {tt.divisibility = 16 : i32} loc("output_ptr"), %input_ptr: !tt.ptr<f16> {tt.divisibility = 16 : i32} loc("input_ptr"), %M: i32 {tt.divisibility = 16 : i32} loc("M"), %N: i32 {tt.divisibility = 16 : i32} loc("N"), %K: i32 {tt.divisibility = 16 : i32} loc("K")) attributes {noinline = false} {
    %zero = arith.constant 0 : i32
    %step = arith.constant 32 : i32
    %width = arith.constant 1024 : i32
    %pm = tt.get_program_id x : i32
    %pk = tt.get_program_id y : i32
    %kb = arith.muli %pk, %width : i32
    %mn = arith.muli %pm, %N : i32
    %base = arith.muli %mn, %K : i32
    %kr = tt.make_range {end = 1024 : i32, start = 0 : i32} : tensor<1024xi32>
    %kbs = tt.splat %kb : i32 -> tensor<1024xi32>
    %ko = arith.addi %kr, %kbs : tensor<1024xi32>
    %ks = tt.splat %K : i32 -> tensor<1024xi32>
    %km = arith.cmpi slt, %ko, %ks : tensor<1024xi32>
    %nr = tt.make_range {end = 32 : i32, start = 0 : i32} : tensor<32xi32>
    %ne = tt.expand_dims %nr {axis = 1 : i32} : tensor<32xi32> -> tensor<32x1xi32>
    %ke = tt.expand_dims %ko {axis = 0 : i32} : tensor<1024xi32> -> tensor<1x1024xi32>
    %kt = tt.broadcast %ke : tensor<1x1024xi32> -> tensor<32x1024xi32>
    %ns = tt.splat %N : i32 -> tensor<32x1024xi32>
    %stride = tt.splat %K : i32 -> tensor<32x1024xi32>
    %bs = tt.splat %base : i32 -> tensor<32x1024xi32>
    %zero_f = arith.constant dense<0.0> : tensor<32x1024xf32>
    %zero_h = arith.constant dense<0.0> : tensor<32x1024xf16>
    %ip = tt.splat %input_ptr : !tt.ptr<f16> -> tensor<32x1024x!tt.ptr<f16>>
    %acc = scf.for %n = %zero to %N step %step iter_args(%sum = %zero_f) -> (tensor<32x1024xf32>) : i32 {
      %nscalar = tt.splat %n : i32 -> tensor<32x1xi32>
      %ni = arith.addi %nscalar, %ne : tensor<32x1xi32>
      %nt = tt.broadcast %ni : tensor<32x1xi32> -> tensor<32x1024xi32>
      %nm = arith.cmpi slt, %nt, %ns : tensor<32x1024xi32>
      %kmt = arith.cmpi slt, %kt, %stride : tensor<32x1024xi32>
      %mask = arith.andi %nm, %kmt : tensor<32x1024xi1>
      %no = arith.muli %nt, %stride : tensor<32x1024xi32>
      %off0 = arith.addi %no, %kt : tensor<32x1024xi32>
      %off = arith.addi %off0, %bs : tensor<32x1024xi32>
      %ptr = tt.addptr %ip, %off : tensor<32x1024x!tt.ptr<f16>>, tensor<32x1024xi32>
      %v = tt.load %ptr, %mask, %zero_h : tensor<32x1024x!tt.ptr<f16>>
      %vf = arith.extf %v : tensor<32x1024xf16> to tensor<32x1024xf32>
      %add = arith.addf %sum, %vf : tensor<32x1024xf32>
      scf.yield %add : tensor<32x1024xf32>
    }
    %reduced = "tt.reduce"(%acc) ({
    ^bb0(%a: f32, %b: f32):
      %c = arith.addf %a, %b : f32
      tt.reduce.return %c : f32
    }) {axis = 0 : i32} : (tensor<32x1024xf32>) -> tensor<1024xf32>
    %nf = arith.sitofp %N : i32 to f32
    %nfs = tt.splat %nf : f32 -> tensor<1024xf32>
    %avg = arith.divf %reduced, %nfs : tensor<1024xf32>
    %avg_h = arith.truncf %avg : tensor<1024xf32> to tensor<1024xf16>
    %ob = arith.muli %pm, %K : i32
    %obs = tt.splat %ob : i32 -> tensor<1024xi32>
    %oo = arith.addi %obs, %ko : tensor<1024xi32>
    %op = tt.splat %output_ptr : !tt.ptr<f16> -> tensor<1024x!tt.ptr<f16>>
    %optr = tt.addptr %op, %oo : tensor<1024x!tt.ptr<f16>>, tensor<1024xi32>
    tt.store %optr, %avg_h, %km : tensor<1024x!tt.ptr<f16>>
    tt.return
  } loc(#loc)
} loc(#loc)
#loc = loc(unknown)
