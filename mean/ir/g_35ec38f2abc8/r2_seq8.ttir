module {
  tt.func public @mean_dim_kernel_non_inner_vec(%output_ptr: !tt.ptr<f16> {tt.divisibility = 16 : i32} loc("output_ptr"), %input_ptr: !tt.ptr<f16> {tt.divisibility = 16 : i32} loc("input_ptr"), %M: i32 loc("M"), %N: i32 loc("N"), %K: i32 {tt.divisibility = 16 : i32} loc("K")) attributes {noinline = false} {
    %z = arith.constant 0 : i32
    %one = arith.constant 1 : i32
    %w = arith.constant 1024 : i32
