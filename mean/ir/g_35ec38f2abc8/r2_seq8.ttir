    %bs7 = tt.splat %bas7 : i32 -> tensor<1024xi32>
    %off7 = arith.addi %bs7, %ko : tensor<1024xi32>
    %ptr7 = tt.addptr %ip, %off7 : tensor<1024x!tt.ptr<f16>>, tensor<1024xi32>
    %v7 = tt.load %ptr7, %mask7, %zeroh : tensor<1024x!tt.ptr<f16>>
    %vf7 = arith.extf %v7 : tensor<1024xf16> to tensor<1024xf32>
    %a0 = arith.addf %s0, %vf0 : tensor<1024xf32>
    %a1 = arith.addf %a0, %vf1 : tensor<1024xf32>
    %a2 = arith.addf %a1, %vf2 : tensor<1024xf32>
    %a3 = arith.addf %a2, %vf3 : tensor<1024xf32>
    %a4 = arith.addf %a3, %vf4 : tensor<1024xf32>
    %a5 = arith.addf %a4, %vf5 : tensor<1024xf32>
    %a6 = arith.addf %a5, %vf6 : tensor<1024xf32>
    %a7 = arith.addf %a6, %vf7 : tensor<1024xf32>
    scf.yield %a7 : tensor<1024xf32>
    }
    %nf = arith.sitofp %N : i32 to f32
