module {
  tt.func public @mean_dim_kernel_inner(%output_ptr: !tt.ptr<f16> {tt.divisibility = 16 : i32} loc("output_ptr"), %input_ptr: !tt.ptr<f16> {tt.divisibility = 16 : i32} loc("input_ptr"), %M: i32 {tt.divisibility = 16 : i32} loc("M"), %N: i32 {tt.divisibility = 16 : i32} loc("N")) attributes {noinline = false} {
    %cst = arith.constant dense<0.000000e+00> : tensor<4096xf32> loc(#loc)
    %cst_0 = arith.constant dense<0.000000e+00> : tensor<4096xf16> loc(#loc)
    %c4096_i32 = arith.constant 4096 : i32 loc(#loc)
    %c0_i32 = arith.constant 0 : i32 loc(#loc)
    %0 = tt.get_program_id x : i32 loc(#loc)
    %1 = arith.extsi %0 : i32 to i64 loc(#loc)
    %sum_vec = scf.for %start_n = %c0_i32 to %N step %c4096_i32 iter_args(%sum_vec_1 = %cst) -> (tensor<4096xf32>)  : i32 {
      %7 = tt.make_range {end = 4096 : i32, start = 0 : i32} : tensor<4096xi32> loc(#loc)
      %8 = tt.splat %start_n : i32 -> tensor<4096xi32> loc(#loc)
      %9 = arith.addi %8, %7 : tensor<4096xi32> loc(#loc)
      %10 = arith.extsi %N : i32 to i64 loc(#loc)
      %11 = arith.muli %1, %10 : i64 loc(#loc)
      %12 = arith.extsi %9 : tensor<4096xi32> to tensor<4096xi64> loc(#loc)
      %13 = tt.splat %11 : i64 -> tensor<4096xi64> loc(#loc)
      %14 = arith.addi %13, %12 : tensor<4096xi64> loc(#loc)
      %15 = tt.splat %N : i32 -> tensor<4096xi32> loc(#loc)
      %16 = arith.cmpi slt, %9, %15 : tensor<4096xi32> loc(#loc)
      %17 = tt.splat %input_ptr : !tt.ptr<f16> -> tensor<4096x!tt.ptr<f16>> loc(#loc)
      %18 = tt.addptr %17, %14 : tensor<4096x!tt.ptr<f16>>, tensor<4096xi64> loc(#loc)
      %19 = tt.load %18, %16, %cst_0 : tensor<4096x!tt.ptr<f16>> loc(#loc)
      %20 = arith.extf %19 : tensor<4096xf16> to tensor<4096xf32> loc(#loc)
      %21 = arith.addf %sum_vec_1, %20 : tensor<4096xf32> loc(#loc)
      scf.yield %21 : tensor<4096xf32> loc(#loc)
    } loc(#loc5)
    %2 = "tt.reduce"(%sum_vec) <{axis = 0 : i32}> ({
    ^bb0(%arg4: f32 loc(unknown), %arg5: f32 loc(unknown)):
      %7 = arith.addf %arg4, %arg5 : f32 loc(#loc)
      tt.reduce.return %7 : f32 loc(#loc)
    }) : (tensor<4096xf32>) -> f32 loc(#loc)
    %3 = arith.sitofp %N : i32 to f32 loc(#loc)
    %4 = arith.divf %2, %3 : f32 loc(#loc)
    %5 = tt.addptr %output_ptr, %1 : !tt.ptr<f16>, i64 loc(#loc)
    %6 = arith.truncf %4 : f32 to f16 loc(#loc)
    tt.store %5, %6 : !tt.ptr<f16> loc(#loc)
    tt.return loc(#loc)
  } loc(#loc)
} loc(#loc)
