#loc3 = loc("K")
module {
  tt.func public @mean_dim_kernel_non_inner_vec(%output_ptr: !tt.ptr<f16> {tt.divisibility = 16 : i32} loc("output_ptr"), %input_ptr: !tt.ptr<f16> {tt.divisibility = 16 : i32} loc("input_ptr"), %K: i32 {tt.divisibility = 16 : i32} loc("K")) attributes {noinline = false} {
    %cst = arith.constant dense<0.000000e+00> : tensor<128x8xf32> loc(#loc)
    %cst_0 = arith.constant dense<0.000000e+00> : tensor<128x8xf16> loc(#loc)
    %c1024_i32 = arith.constant 1024 : i32 loc(#loc)
    %cst_1 = arith.constant dense<8> : tensor<128x1xi32> loc(#loc)
    %0 = tt.get_program_id x : i32 loc(#loc)
    %2 = tt.get_program_id y : i32 loc(#loc)
    %4 = arith.muli %2, %c1024_i32 : i32 loc(#loc)
    %5 = tt.make_range {end = 128 : i32, start = 0 : i32} : tensor<128xi32> loc(#loc)
    %6 = tt.expand_dims %5 {axis = 1 : i32} : tensor<128xi32> -> tensor<128x1xi32> loc(#loc)
    %7 = arith.muli %6, %cst_1 : tensor<128x1xi32> loc(#loc)
    %9 = tt.splat %4 : i32 -> tensor<128x1xi32> loc(#loc)
    %10 = arith.addi %9, %7 : tensor<128x1xi32> loc(#loc)
    %11 = tt.make_range {end = 8 : i32, start = 0 : i32} : tensor<8xi32> loc(#loc)
    %12 = tt.expand_dims %11 {axis = 0 : i32} : tensor<8xi32> -> tensor<1x8xi32> loc(#loc)
    %14 = tt.broadcast %10 : tensor<128x1xi32> -> tensor<128x8xi32> loc(#loc)
    %15 = tt.broadcast %12 : tensor<1x8xi32> -> tensor<128x8xi32> loc(#loc)
    %16 = arith.addi %14, %15 : tensor<128x8xi32> loc(#loc)
    %18 = tt.splat %K : i32 -> tensor<128x8xi32> loc(#loc)
    %19 = arith.cmpi slt, %16, %18 : tensor<128x8xi32> loc(#loc)
    %20 = arith.muli %0, %K : i32 loc(#loc)
    %21 = tt.splat %20 : i32 -> tensor<128x8xi32> loc(#loc)
    %22 = arith.addi %21, %16 : tensor<128x8xi32> loc(#loc)
    %23 = tt.splat %input_ptr : !tt.ptr<f16> -> tensor<128x8x!tt.ptr<f16>> loc(#loc)
    %24 = tt.addptr %23, %22 : tensor<128x8x!tt.ptr<f16>>, tensor<128x8xi32> loc(#loc)
    %25 = tt.load %24, %19, %cst_0 : tensor<128x8x!tt.ptr<f16>> loc(#loc)
    %26 = arith.extf %25 : tensor<128x8xf16> to tensor<128x8xf32> loc(#loc)
    %27 = arith.addf %26, %cst : tensor<128x8xf32> loc(#loc)
    %28 = tt.splat %output_ptr : !tt.ptr<f16> -> tensor<128x8x!tt.ptr<f16>> loc(#loc)
    %29 = tt.addptr %28, %22 : tensor<128x8x!tt.ptr<f16>>, tensor<128x8xi32> loc(#loc)
    %30 = arith.truncf %27 : tensor<128x8xf32> to tensor<128x8xf16> loc(#loc)
    tt.store %29, %30, %19 : tensor<128x8x!tt.ptr<f16>> loc(#loc)
    tt.return loc(#loc)
  } loc(#loc)
} loc(#loc)
