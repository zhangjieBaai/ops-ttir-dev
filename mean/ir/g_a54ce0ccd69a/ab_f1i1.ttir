#loc1 = loc("output_ptr")
#loc2 = loc("input_ptr")
#loc3 = loc("K")
module {
  tt.func public @mean_dim_kernel_non_inner_vec(%output_ptr: !tt.ptr<f16> {tt.divisibility = 16 : i32} loc("output_ptr"), %input_ptr: !tt.ptr<f16> {tt.divisibility = 16 : i32} loc("input_ptr"), %K: i32 {tt.divisibility = 16 : i32} loc("K")) attributes {noinline = false} {
    %cst = arith.constant dense<0.000000e+00> : tensor<1024xf32> loc(#loc)
    %cst_0 = arith.constant dense<0.000000e+00> : tensor<1024xf16> loc(#loc)
    %c1024_i32 = arith.constant 1024 : i32 loc(#loc)
    %0 = tt.get_program_id x : i32 loc(#loc)
    %2 = tt.get_program_id y : i32 loc(#loc)
    %4 = arith.muli %2, %c1024_i32 : i32 loc(#loc)
    %ab_range = tt.make_range {end = 1024 : i32, start = 0 : i32} : tensor<1024xi32>
    %ab_kbase = tt.splat %4 : i32 -> tensor<1024xi32>
    %16 = arith.addi %ab_kbase, %ab_range : tensor<1024xi32>
    %18 = tt.splat %K : i32 -> tensor<1024xi32> loc(#loc)
    %19 = arith.cmpi slt, %16, %18 : tensor<1024xi32> loc(#loc)
    %20 = arith.muli %0, %K : i32 loc(#loc)
    %21 = tt.splat %20 : i32 -> tensor<1024xi32> loc(#loc)
    %22 = arith.addi %21, %16 : tensor<1024xi32> loc(#loc)
    %23 = tt.splat %input_ptr : !tt.ptr<f16> -> tensor<1024x!tt.ptr<f16>> loc(#loc)
    %24 = tt.addptr %23, %22 : tensor<1024x!tt.ptr<f16>>, tensor<1024xi32> loc(#loc)
    %25 = tt.load %24, %19, %cst_0 : tensor<1024x!tt.ptr<f16>> loc(#loc)
    %26 = arith.extf %25 : tensor<1024xf16> to tensor<1024xf32> loc(#loc)
    %27 = arith.addf %26, %cst : tensor<1024xf32> loc(#loc)
    %28 = tt.splat %output_ptr : !tt.ptr<f16> -> tensor<1024x!tt.ptr<f16>> loc(#loc)
    %29 = tt.addptr %28, %22 : tensor<1024x!tt.ptr<f16>>, tensor<1024xi32> loc(#loc)
    %30 = arith.truncf %27 : tensor<1024xf32> to tensor<1024xf16> loc(#loc)
    tt.store %29, %30, %19 : tensor<1024x!tt.ptr<f16>> loc(#loc)
    tt.return loc(#loc)
  } loc(#loc)
} loc(#loc)
#loc = loc(unknown)
