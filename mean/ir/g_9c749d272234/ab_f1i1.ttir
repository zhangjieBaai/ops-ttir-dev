module {
  tt.func public @mean_dim_kernel_non_inner_vec(%output_ptr: !tt.ptr<f16> {tt.divisibility = 16 : i32} loc("output_ptr"), %input_ptr: !tt.ptr<f16> {tt.divisibility = 16 : i32} loc("input_ptr"), %N: i32 loc("N"), %K: i32 loc("K")) attributes {noinline = false} {
    %cst = arith.constant dense<0.000000e+00> : tensor<1024xf32> loc(#loc)
    %cst_0 = arith.constant dense<0.000000e+00> : tensor<1024xf16> loc(#loc)
