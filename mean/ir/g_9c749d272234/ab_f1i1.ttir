    %30 = tt.addptr %29, %28 : tensor<1024x!tt.ptr<f16>>, tensor<1024xi32> loc(#loc)
    %31 = arith.truncf %25 : tensor<1024xf32> to tensor<1024xf16> loc(#loc)
