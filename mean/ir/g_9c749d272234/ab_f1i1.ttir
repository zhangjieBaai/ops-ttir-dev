    %acc = scf.for %n = %c0_i32 to %N step %c1_i32 iter_args(%acc_2 = %cst) -> (tensor<1024xf32>)  : i32 {
      %32 = arith.muli %n, %K : i32 loc(#loc)
      %34 = arith.addi %22, %32 : i32 loc(#loc)
      %35 = tt.splat %34 : i32 -> tensor<1024xi32> loc(#loc)
      %36 = arith.addi %35, %16 : tensor<1024xi32> loc(#loc)
      %37 = tt.splat %input_ptr : !tt.ptr<f16> -> tensor<1024x!tt.ptr<f16>> loc(#loc)
      %38 = tt.addptr %37, %36 : tensor<1024x!tt.ptr<f16>>, tensor<1024xi32> loc(#loc)
      %39 = tt.load %38, %19, %cst_0 : tensor<1024x!tt.ptr<f16>> loc(#loc)
      %40 = arith.extf %39 : tensor<1024xf16> to tensor<1024xf32> loc(#loc)
      %41 = arith.addf %acc_2, %40 : tensor<1024xf32> loc(#loc)
