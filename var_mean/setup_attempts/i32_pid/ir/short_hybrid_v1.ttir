module {
  tt.func public @var_mean_welford_kernel(%X: !tt.ptr<f32> {tt.divisibility = 16 : i32}, %Var: !tt.ptr<f32> {tt.divisibility = 16 : i32}, %Mean: !tt.ptr<f32> {tt.divisibility = 16 : i32}, %M: i32, %N: i32, %correction: f32) attributes {noinline = false} {
    %c256_i32 = arith.constant 256 : i32
    %c0_i32 = arith.constant 0 : i32
    %cst = arith.constant dense<0.000000e+00> : tensor<256xf32>
    %0 = tt.get_program_id x : i32
    %1 = arith.muli %0, %N : i32
    %2 = tt.addptr %X, %1 : !tt.ptr<f32>, i32
    %3 = tt.addptr %Var, %0 : !tt.ptr<f32>, i32
    %4 = tt.addptr %Mean, %0 : !tt.ptr<f32>, i32
%limit128 = arith.constant 128 : i32
%short128 = arith.cmpi sle, %N, %limit128 : i32
scf.if %short128 {
%zero = arith.constant dense<0.0> : tensor<128xf32>
%cols = tt.make_range {end = 128 : i32, start = 0 : i32} : tensor<128xi32>
%limit = tt.splat %N : i32 -> tensor<128xi32>
%mask = arith.cmpi slt, %cols, %limit : tensor<128xi32>
%ptr = tt.splat %2 : !tt.ptr<f32> -> tensor<128x!tt.ptr<f32>>
%addrs = tt.addptr %ptr, %cols : tensor<128x!tt.ptr<f32>>, tensor<128xi32>
%values = tt.load %addrs, %mask, %zero : tensor<128x!tt.ptr<f32>>
%sum = "tt.reduce"(%values) <{axis = 0 : i32}> ({
^bb0(%a: f32, %b: f32):
    %s = arith.addf %a, %b : f32
    tt.reduce.return %s : f32
}) : (tensor<128xf32>) -> f32
%nf = arith.sitofp %N : i32 to f32
%avg = arith.divf %sum, %nf : f32
%avgvec = tt.splat %avg : f32 -> tensor<128xf32>
%diff = arith.subf %values, %avgvec : tensor<128xf32>
%centered = arith.select %mask, %diff, %zero : tensor<128xi1>, tensor<128xf32>
%squares = arith.mulf %centered, %centered : tensor<128xf32>
%ss = "tt.reduce"(%squares) <{axis = 0 : i32}> ({
^bb0(%a: f32, %b: f32):
    %s = arith.addf %a, %b : f32
    tt.reduce.return %s : f32
}) : (tensor<128xf32>) -> f32
%denom = arith.subf %nf, %correction : f32
%variance = arith.divf %ss, %denom : f32
 tt.store %4, %avg : !tt.ptr<f32>
 tt.store %3, %variance : !tt.ptr<f32>

} else {
%limit512 = arith.constant 512 : i32
%short512 = arith.cmpi sle, %N, %limit512 : i32
scf.if %short512 {
%zero = arith.constant dense<0.0> : tensor<512xf32>
%cols = tt.make_range {end = 512 : i32, start = 0 : i32} : tensor<512xi32>
%limit = tt.splat %N : i32 -> tensor<512xi32>
%mask = arith.cmpi slt, %cols, %limit : tensor<512xi32>
%ptr = tt.splat %2 : !tt.ptr<f32> -> tensor<512x!tt.ptr<f32>>
%addrs = tt.addptr %ptr, %cols : tensor<512x!tt.ptr<f32>>, tensor<512xi32>
%values = tt.load %addrs, %mask, %zero : tensor<512x!tt.ptr<f32>>
%sum = "tt.reduce"(%values) <{axis = 0 : i32}> ({
^bb0(%a: f32, %b: f32):
    %s = arith.addf %a, %b : f32
    tt.reduce.return %s : f32
}) : (tensor<512xf32>) -> f32
%nf = arith.sitofp %N : i32 to f32
%avg = arith.divf %sum, %nf : f32
%avgvec = tt.splat %avg : f32 -> tensor<512xf32>
%diff = arith.subf %values, %avgvec : tensor<512xf32>
%centered = arith.select %mask, %diff, %zero : tensor<512xi1>, tensor<512xf32>
%squares = arith.mulf %centered, %centered : tensor<512xf32>
%ss = "tt.reduce"(%squares) <{axis = 0 : i32}> ({
^bb0(%a: f32, %b: f32):
    %s = arith.addf %a, %b : f32
    tt.reduce.return %s : f32
}) : (tensor<512xf32>) -> f32
%denom = arith.subf %nf, %correction : f32
%variance = arith.divf %ss, %denom : f32
 tt.store %4, %avg : !tt.ptr<f32>
 tt.store %3, %variance : !tt.ptr<f32>

} else {
%limit1024 = arith.constant 1024 : i32
%short1024 = arith.cmpi sle, %N, %limit1024 : i32
scf.if %short1024 {
%zero = arith.constant dense<0.0> : tensor<1024xf32>
%cols = tt.make_range {end = 1024 : i32, start = 0 : i32} : tensor<1024xi32>
%limit = tt.splat %N : i32 -> tensor<1024xi32>
%mask = arith.cmpi slt, %cols, %limit : tensor<1024xi32>
%ptr = tt.splat %2 : !tt.ptr<f32> -> tensor<1024x!tt.ptr<f32>>
%addrs = tt.addptr %ptr, %cols : tensor<1024x!tt.ptr<f32>>, tensor<1024xi32>
%values = tt.load %addrs, %mask, %zero : tensor<1024x!tt.ptr<f32>>
%sum = "tt.reduce"(%values) <{axis = 0 : i32}> ({
^bb0(%a: f32, %b: f32):
    %s = arith.addf %a, %b : f32
    tt.reduce.return %s : f32
}) : (tensor<1024xf32>) -> f32
%nf = arith.sitofp %N : i32 to f32
%avg = arith.divf %sum, %nf : f32
%avgvec = tt.splat %avg : f32 -> tensor<1024xf32>
%diff = arith.subf %values, %avgvec : tensor<1024xf32>
%centered = arith.select %mask, %diff, %zero : tensor<1024xi1>, tensor<1024xf32>
%squares = arith.mulf %centered, %centered : tensor<1024xf32>
%ss = "tt.reduce"(%squares) <{axis = 0 : i32}> ({
^bb0(%a: f32, %b: f32):
    %s = arith.addf %a, %b : f32
    tt.reduce.return %s : f32
}) : (tensor<1024xf32>) -> f32
%denom = arith.subf %nf, %correction : f32
%variance = arith.divf %ss, %denom : f32
 tt.store %4, %avg : !tt.ptr<f32>
 tt.store %3, %variance : !tt.ptr<f32>

} else {
    %_sum = scf.for %off = %c0_i32 to %N step %c256_i32 iter_args(%_sum_0 = %cst) -> (tensor<256xf32>)  : i32 {
      %13 = tt.make_range {end = 256 : i32, start = 0 : i32} : tensor<256xi32>
      %14 = tt.splat %off : i32 -> tensor<256xi32>
      %15 = arith.addi %14, %13 : tensor<256xi32>
      %16 = tt.splat %N : i32 -> tensor<256xi32>
      %17 = arith.cmpi slt, %15, %16 : tensor<256xi32>
      %18 = tt.splat %2 : !tt.ptr<f32> -> tensor<256x!tt.ptr<f32>>
      %19 = tt.addptr %18, %15 : tensor<256x!tt.ptr<f32>>, tensor<256xi32>
      %20 = tt.load %19, %17, %cst : tensor<256x!tt.ptr<f32>>
      %21 = arith.addf %_sum_0, %20 : tensor<256xf32>
      scf.yield %21 : tensor<256xf32>
    }
    %5 = tt.reshape %_sum allow_reorder : tensor<256xf32> -> tensor<256xf32>
    %6 = "tt.reduce"(%5) <{axis = 0 : i32}> ({
    ^bb0(%arg6: f32, %arg7: f32):
      %13 = arith.addf %arg6, %arg7 : f32
      tt.reduce.return %13 : f32
    }) : (tensor<256xf32>) -> f32
    %7 = arith.sitofp %N : i32 to f32
    %8 = arith.divf %6, %7 : f32
    %_acc = scf.for %off = %c0_i32 to %N step %c256_i32 iter_args(%_acc_0 = %cst) -> (tensor<256xf32>)  : i32 {
      %13 = tt.make_range {end = 256 : i32, start = 0 : i32} : tensor<256xi32>
      %14 = tt.splat %off : i32 -> tensor<256xi32>
      %15 = arith.addi %14, %13 : tensor<256xi32>
      %16 = tt.splat %N : i32 -> tensor<256xi32>
      %17 = arith.cmpi slt, %15, %16 : tensor<256xi32>
      %18 = tt.splat %2 : !tt.ptr<f32> -> tensor<256x!tt.ptr<f32>>
      %19 = tt.addptr %18, %15 : tensor<256x!tt.ptr<f32>>, tensor<256xi32>
      %20 = tt.load %19, %17, %cst : tensor<256x!tt.ptr<f32>>
      %21 = tt.splat %8 : f32 -> tensor<256xf32>
      %22 = arith.subf %20, %21 : tensor<256xf32>
      %23 = arith.select %17, %22, %cst : tensor<256xi1>, tensor<256xf32>
      %24 = arith.mulf %23, %23 : tensor<256xf32>
      %25 = arith.addf %_acc_0, %24 : tensor<256xf32>
      scf.yield %25 : tensor<256xf32>
    }
    %9 = tt.reshape %_acc allow_reorder : tensor<256xf32> -> tensor<256xf32>
    %10 = "tt.reduce"(%9) <{axis = 0 : i32}> ({
    ^bb0(%arg6: f32, %arg7: f32):
      %13 = arith.addf %arg6, %arg7 : f32
      tt.reduce.return %13 : f32
    }) : (tensor<256xf32>) -> f32
    %11 = arith.subf %7, %correction : f32
    %12 = arith.divf %10, %11 : f32
    tt.store %4, %8 : !tt.ptr<f32>
    tt.store %3, %12 : !tt.ptr<f32>
}
}
}
tt.return
  }
}
