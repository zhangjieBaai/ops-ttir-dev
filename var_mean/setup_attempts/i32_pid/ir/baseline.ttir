#loc = loc(unknown)
#loc1 = loc("X")
#loc2 = loc("Var")
#loc3 = loc("Mean")
#loc4 = loc("M")
#loc5 = loc("N")
#loc6 = loc("correction")
module {
  tt.func public @var_mean_welford_kernel(%X: !tt.ptr<f32> {tt.divisibility = 16 : i32} loc("X"), %Var: !tt.ptr<f32> {tt.divisibility = 16 : i32} loc("Var"), %Mean: !tt.ptr<f32> {tt.divisibility = 16 : i32} loc("Mean"), %M: i32 loc("M"), %N: i32 loc("N"), %correction: f32 loc("correction")) attributes {noinline = false} {
    %c1024_i32 = arith.constant 1024 : i32 loc(#loc)
    %c0_i32 = arith.constant 0 : i32 loc(#loc)
    %cst = arith.constant dense<0.000000e+00> : tensor<1024xf32> loc(#loc)
    %0 = tt.get_program_id x : i32 loc(#loc)
    %1 = arith.muli %0, %N : i32 loc(#loc)
    %2 = tt.addptr %X, %1 : !tt.ptr<f32>, i32 loc(#loc)
    %3 = tt.addptr %Var, %0 : !tt.ptr<f32>, i32 loc(#loc)
    %4 = tt.addptr %Mean, %0 : !tt.ptr<f32>, i32 loc(#loc)
    %_sum = scf.for %off = %c0_i32 to %N step %c1024_i32 iter_args(%_sum_0 = %cst) -> (tensor<1024xf32>)  : i32 {
      %13 = tt.make_range {end = 1024 : i32, start = 0 : i32} : tensor<1024xi32> loc(#loc)
      %14 = tt.splat %off : i32 -> tensor<1024xi32> loc(#loc)
      %15 = arith.addi %14, %13 : tensor<1024xi32> loc(#loc)
      %16 = tt.splat %N : i32 -> tensor<1024xi32> loc(#loc)
      %17 = arith.cmpi slt, %15, %16 : tensor<1024xi32> loc(#loc)
      %18 = tt.splat %2 : !tt.ptr<f32> -> tensor<1024x!tt.ptr<f32>> loc(#loc)
      %19 = tt.addptr %18, %15 : tensor<1024x!tt.ptr<f32>>, tensor<1024xi32> loc(#loc)
      %20 = tt.load %19, %17, %cst : tensor<1024x!tt.ptr<f32>> loc(#loc)
      %21 = arith.addf %_sum_0, %20 : tensor<1024xf32> loc(#loc)
      scf.yield %21 : tensor<1024xf32> loc(#loc)
    } loc(#loc7)
    %5 = tt.reshape %_sum allow_reorder : tensor<1024xf32> -> tensor<1024xf32> loc(#loc)
    %6 = "tt.reduce"(%5) <{axis = 0 : i32}> ({
    ^bb0(%arg6: f32 loc(unknown), %arg7: f32 loc(unknown)):
      %13 = arith.addf %arg6, %arg7 : f32 loc(#loc)
      tt.reduce.return %13 : f32 loc(#loc)
    }) : (tensor<1024xf32>) -> f32 loc(#loc)
    %7 = arith.sitofp %N : i32 to f32 loc(#loc)
    %8 = arith.divf %6, %7 : f32 loc(#loc)
    %_acc = scf.for %off = %c0_i32 to %N step %c1024_i32 iter_args(%_acc_0 = %cst) -> (tensor<1024xf32>)  : i32 {
      %13 = tt.make_range {end = 1024 : i32, start = 0 : i32} : tensor<1024xi32> loc(#loc)
      %14 = tt.splat %off : i32 -> tensor<1024xi32> loc(#loc)
      %15 = arith.addi %14, %13 : tensor<1024xi32> loc(#loc)
      %16 = tt.splat %N : i32 -> tensor<1024xi32> loc(#loc)
      %17 = arith.cmpi slt, %15, %16 : tensor<1024xi32> loc(#loc)
      %18 = tt.splat %2 : !tt.ptr<f32> -> tensor<1024x!tt.ptr<f32>> loc(#loc)
      %19 = tt.addptr %18, %15 : tensor<1024x!tt.ptr<f32>>, tensor<1024xi32> loc(#loc)
      %20 = tt.load %19, %17, %cst : tensor<1024x!tt.ptr<f32>> loc(#loc)
      %21 = tt.splat %8 : f32 -> tensor<1024xf32> loc(#loc)
      %22 = arith.subf %20, %21 : tensor<1024xf32> loc(#loc)
      %23 = arith.select %17, %22, %cst : tensor<1024xi1>, tensor<1024xf32> loc(#loc)
      %24 = arith.mulf %23, %23 : tensor<1024xf32> loc(#loc)
      %25 = arith.addf %_acc_0, %24 : tensor<1024xf32> loc(#loc)
      scf.yield %25 : tensor<1024xf32> loc(#loc)
    } loc(#loc8)
    %9 = tt.reshape %_acc allow_reorder : tensor<1024xf32> -> tensor<1024xf32> loc(#loc)
    %10 = "tt.reduce"(%9) <{axis = 0 : i32}> ({
    ^bb0(%arg6: f32 loc(unknown), %arg7: f32 loc(unknown)):
      %13 = arith.addf %arg6, %arg7 : f32 loc(#loc)
      tt.reduce.return %13 : f32 loc(#loc)
    }) : (tensor<1024xf32>) -> f32 loc(#loc)
    %11 = arith.subf %7, %correction : f32 loc(#loc)
    %12 = arith.divf %10, %11 : f32 loc(#loc)
    tt.store %4, %8 : !tt.ptr<f32> loc(#loc)
    tt.store %3, %12 : !tt.ptr<f32> loc(#loc)
    tt.return loc(#loc)
  } loc(#loc)
} loc(#loc)
#loc7 = loc("_sum")
#loc8 = loc("_acc")
