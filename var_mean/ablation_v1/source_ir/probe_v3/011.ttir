#loc = loc(unknown)
#loc1 = loc("X")
#loc2 = loc("Var")
#loc3 = loc("Mean")
#loc4 = loc("M")
#loc5 = loc("N")
#loc6 = loc("correction")
#loc8 = loc("mean")
#loc10 = loc("variance"(#loc8))
#loc12 = loc(callsite(#loc at #loc10))
module {
  tt.func public @source_variant(%X: !tt.ptr<f32> {tt.divisibility = 16 : i32} loc("X"), %Var: !tt.ptr<f32> {tt.divisibility = 16 : i32} loc("Var"), %Mean: !tt.ptr<f32> {tt.divisibility = 16 : i32} loc("Mean"), %M: i32 loc("M"), %N: i32 {tt.divisibility = 16 : i32} loc("N"), %correction: f32 loc("correction")) attributes {noinline = false} {
    %cst = arith.constant dense<0.000000e+00> : tensor<256xf32> loc(#loc)
    %c256_i32 = arith.constant 256 : i32 loc(#loc)
    %cst_0 = arith.constant dense<0.000000e+00> : tensor<1024xf32> loc(#loc)
    %c0_i32 = arith.constant 0 : i32 loc(#loc)
    %c1024_i32 = arith.constant 1024 : i32 loc(#loc)
    %0 = tt.get_program_id x : i32 loc(#loc)
    %1 = arith.extsi %0 : i32 to i64 loc(#loc)
    %2 = arith.extsi %N : i32 to i64 loc(#loc)
    %3 = arith.muli %1, %2 : i64 loc(#loc)
    %4 = tt.addptr %X, %3 : !tt.ptr<f32>, i64 loc(#loc)
    %5 = arith.cmpi sle, %N, %c1024_i32 : i32 loc(#loc)
    %6:2 = scf.if %5 -> (f32, f32) {
      %sums = scf.for %off = %c0_i32 to %N step %c1024_i32 iter_args(%sums_6 = %cst_0) -> (tensor<1024xf32>)  : i32 {
        %variance_7 = tt.make_range {end = 1024 : i32, start = 0 : i32} : tensor<1024xi32> loc(#loc12)
        %variance_8 = tt.splat %off : i32 -> tensor<1024xi32> loc(#loc12)
        %variance_9 = arith.addi %variance_8, %variance_7 : tensor<1024xi32> loc(#loc12)
        %variance_10 = tt.splat %4 : !tt.ptr<f32> -> tensor<1024x!tt.ptr<f32>> loc(#loc12)
        %variance_11 = tt.addptr %variance_10, %variance_9 : tensor<1024x!tt.ptr<f32>>, tensor<1024xi32> loc(#loc12)
        %variance_12 = tt.splat %N : i32 -> tensor<1024xi32> loc(#loc12)
        %variance_13 = arith.cmpi slt, %variance_9, %variance_12 : tensor<1024xi32> loc(#loc12)
        %variance_14 = tt.load %variance_11, %variance_13, %cst_0 : tensor<1024x!tt.ptr<f32>> loc(#loc12)
        %variance_15 = arith.addf %sums_6, %variance_14 : tensor<1024xf32> loc(#loc12)
        scf.yield %variance_15 : tensor<1024xf32> loc(#loc12)
      } loc(#loc11)
      %variance = "tt.reduce"(%sums) <{axis = 0 : i32}> ({
      ^bb0(%variance_6: f32 loc(callsite(#loc at #loc10)), %variance_7: f32 loc(callsite(#loc at #loc10))):
        %variance_8 = arith.addf %variance_6, %variance_7 : f32 loc(#loc12)
        tt.reduce.return %variance_8 : f32 loc(#loc12)
      }) : (tensor<1024xf32>) -> f32 loc(#loc12)
      %variance_1 = arith.sitofp %N : i32 to f32 loc(#loc12)
      %variance_2 = arith.divf %variance, %variance_1 : f32 loc(#loc12)
      %squares = scf.for %off = %c0_i32 to %N step %c1024_i32 iter_args(%squares_6 = %cst_0) -> (tensor<1024xf32>)  : i32 {
        %variance_7 = tt.make_range {end = 1024 : i32, start = 0 : i32} : tensor<1024xi32> loc(#loc12)
        %variance_8 = tt.splat %off : i32 -> tensor<1024xi32> loc(#loc12)
        %variance_9 = arith.addi %variance_8, %variance_7 : tensor<1024xi32> loc(#loc12)
        %variance_10 = tt.splat %4 : !tt.ptr<f32> -> tensor<1024x!tt.ptr<f32>> loc(#loc12)
        %variance_11 = tt.addptr %variance_10, %variance_9 : tensor<1024x!tt.ptr<f32>>, tensor<1024xi32> loc(#loc12)
        %variance_12 = tt.splat %N : i32 -> tensor<1024xi32> loc(#loc12)
        %variance_13 = arith.cmpi slt, %variance_9, %variance_12 : tensor<1024xi32> loc(#loc12)
        %variance_14 = tt.load %variance_11, %variance_13, %cst_0 : tensor<1024x!tt.ptr<f32>> loc(#loc12)
        %variance_15 = tt.splat %variance_2 : f32 -> tensor<1024xf32> loc(#loc12)
        %variance_16 = arith.subf %variance_14, %variance_15 : tensor<1024xf32> loc(#loc12)
        %variance_17 = arith.select %variance_13, %variance_16, %cst_0 : tensor<1024xi1>, tensor<1024xf32> loc(#loc12)
        %variance_18 = arith.mulf %variance_17, %variance_17 : tensor<1024xf32> loc(#loc12)
        %variance_19 = arith.addf %squares_6, %variance_18 : tensor<1024xf32> loc(#loc12)
        scf.yield %variance_19 : tensor<1024xf32> loc(#loc12)
      } loc(#loc13)
      %variance_3 = "tt.reduce"(%squares) <{axis = 0 : i32}> ({
      ^bb0(%variance_6: f32 loc(callsite(#loc at #loc10)), %variance_7: f32 loc(callsite(#loc at #loc10))):
        %variance_8 = arith.addf %variance_6, %variance_7 : f32 loc(#loc12)
        tt.reduce.return %variance_8 : f32 loc(#loc12)
      }) : (tensor<1024xf32>) -> f32 loc(#loc12)
      %variance_4 = arith.subf %variance_1, %correction : f32 loc(#loc12)
      %variance_5 = arith.divf %variance_3, %variance_4 : f32 loc(#loc12)
      scf.yield %variance_2, %variance_5 : f32, f32 loc(#loc)
    } else {
      %sums = scf.for %off = %c0_i32 to %N step %c256_i32 iter_args(%sums_6 = %cst) -> (tensor<256xf32>)  : i32 {
        %variance_7 = tt.make_range {end = 256 : i32, start = 0 : i32} : tensor<256xi32> loc(#loc12)
        %variance_8 = tt.splat %off : i32 -> tensor<256xi32> loc(#loc12)
        %variance_9 = arith.addi %variance_8, %variance_7 : tensor<256xi32> loc(#loc12)
        %variance_10 = tt.splat %4 : !tt.ptr<f32> -> tensor<256x!tt.ptr<f32>> loc(#loc12)
        %variance_11 = tt.addptr %variance_10, %variance_9 : tensor<256x!tt.ptr<f32>>, tensor<256xi32> loc(#loc12)
        %variance_12 = tt.splat %N : i32 -> tensor<256xi32> loc(#loc12)
        %variance_13 = arith.cmpi slt, %variance_9, %variance_12 : tensor<256xi32> loc(#loc12)
        %variance_14 = tt.load %variance_11, %variance_13, %cst : tensor<256x!tt.ptr<f32>> loc(#loc12)
        %variance_15 = arith.addf %sums_6, %variance_14 : tensor<256xf32> loc(#loc12)
        scf.yield %variance_15 : tensor<256xf32> loc(#loc12)
      } loc(#loc11)
      %variance = "tt.reduce"(%sums) <{axis = 0 : i32}> ({
      ^bb0(%variance_6: f32 loc(callsite(#loc at #loc10)), %variance_7: f32 loc(callsite(#loc at #loc10))):
        %variance_8 = arith.addf %variance_6, %variance_7 : f32 loc(#loc12)
        tt.reduce.return %variance_8 : f32 loc(#loc12)
      }) : (tensor<256xf32>) -> f32 loc(#loc12)
      %variance_1 = arith.sitofp %N : i32 to f32 loc(#loc12)
      %variance_2 = arith.divf %variance, %variance_1 : f32 loc(#loc12)
      %squares = scf.for %off = %c0_i32 to %N step %c256_i32 iter_args(%squares_6 = %cst) -> (tensor<256xf32>)  : i32 {
        %variance_7 = tt.make_range {end = 256 : i32, start = 0 : i32} : tensor<256xi32> loc(#loc12)
        %variance_8 = tt.splat %off : i32 -> tensor<256xi32> loc(#loc12)
        %variance_9 = arith.addi %variance_8, %variance_7 : tensor<256xi32> loc(#loc12)
        %variance_10 = tt.splat %4 : !tt.ptr<f32> -> tensor<256x!tt.ptr<f32>> loc(#loc12)
        %variance_11 = tt.addptr %variance_10, %variance_9 : tensor<256x!tt.ptr<f32>>, tensor<256xi32> loc(#loc12)
        %variance_12 = tt.splat %N : i32 -> tensor<256xi32> loc(#loc12)
        %variance_13 = arith.cmpi slt, %variance_9, %variance_12 : tensor<256xi32> loc(#loc12)
        %variance_14 = tt.load %variance_11, %variance_13, %cst : tensor<256x!tt.ptr<f32>> loc(#loc12)
        %variance_15 = tt.splat %variance_2 : f32 -> tensor<256xf32> loc(#loc12)
        %variance_16 = arith.subf %variance_14, %variance_15 : tensor<256xf32> loc(#loc12)
        %variance_17 = arith.select %variance_13, %variance_16, %cst : tensor<256xi1>, tensor<256xf32> loc(#loc12)
        %variance_18 = arith.mulf %variance_17, %variance_17 : tensor<256xf32> loc(#loc12)
        %variance_19 = arith.addf %squares_6, %variance_18 : tensor<256xf32> loc(#loc12)
        scf.yield %variance_19 : tensor<256xf32> loc(#loc12)
      } loc(#loc13)
      %variance_3 = "tt.reduce"(%squares) <{axis = 0 : i32}> ({
      ^bb0(%variance_6: f32 loc(callsite(#loc at #loc10)), %variance_7: f32 loc(callsite(#loc at #loc10))):
        %variance_8 = arith.addf %variance_6, %variance_7 : f32 loc(#loc12)
        tt.reduce.return %variance_8 : f32 loc(#loc12)
      }) : (tensor<256xf32>) -> f32 loc(#loc12)
      %variance_4 = arith.subf %variance_1, %correction : f32 loc(#loc12)
      %variance_5 = arith.divf %variance_3, %variance_4 : f32 loc(#loc12)
      scf.yield %variance_2, %variance_5 : f32, f32 loc(#loc)
    } loc(#loc)
    %7 = tt.addptr %Var, %1 : !tt.ptr<f32>, i64 loc(#loc)
    tt.store %7, %6#1 : !tt.ptr<f32> loc(#loc)
    %8 = tt.addptr %Mean, %1 : !tt.ptr<f32>, i64 loc(#loc)
    tt.store %8, %6#0 : !tt.ptr<f32> loc(#loc)
    tt.return loc(#loc)
  } loc(#loc)
} loc(#loc)
#loc7 = loc("sums")
#loc9 = loc("squares")
#loc11 = loc(callsite(#loc7 at #loc10))
#loc13 = loc(callsite(#loc9 at #loc10))
