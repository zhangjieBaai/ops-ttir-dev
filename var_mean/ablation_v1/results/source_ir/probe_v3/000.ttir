#loc = loc(unknown)
#loc1 = loc("X")
#loc2 = loc("Var")
#loc3 = loc("Mean")
#loc4 = loc("M")
#loc5 = loc("N")
#loc6 = loc("correction")
module {
  tt.func public @source_variant(%X: !tt.ptr<f32> {tt.divisibility = 16 : i32} loc("X"), %Var: !tt.ptr<f32> {tt.divisibility = 16 : i32} loc("Var"), %Mean: !tt.ptr<f32> {tt.divisibility = 16 : i32} loc("Mean"), %M: i32 loc("M"), %N: i32 loc("N"), %correction: f32 loc("correction")) attributes {noinline = false} {
    %cst = arith.constant dense<0.000000e+00> : tensor<1024xf32> loc(#loc)
    %c0_i32 = arith.constant 0 : i32 loc(#loc)
    %c1024_i32 = arith.constant 1024 : i32 loc(#loc)
    %0 = tt.get_program_id x : i32 loc(#loc)
    %1 = arith.extsi %0 : i32 to i64 loc(#loc)
    %2 = arith.extsi %N : i32 to i64 loc(#loc)
    %3 = arith.muli %1, %2 : i64 loc(#loc)
    %4 = tt.addptr %X, %3 : !tt.ptr<f32>, i64 loc(#loc)
    %sums = scf.for %off = %c0_i32 to %N step %c1024_i32 iter_args(%sums_0 = %cst) -> (tensor<1024xf32>)  : i32 {
      %13 = tt.make_range {end = 1024 : i32, start = 0 : i32} : tensor<1024xi32> loc(#loc)
      %14 = tt.splat %off : i32 -> tensor<1024xi32> loc(#loc)
      %15 = arith.addi %14, %13 : tensor<1024xi32> loc(#loc)
      %16 = tt.splat %4 : !tt.ptr<f32> -> tensor<1024x!tt.ptr<f32>> loc(#loc)
      %17 = tt.addptr %16, %15 : tensor<1024x!tt.ptr<f32>>, tensor<1024xi32> loc(#loc)
      %18 = tt.splat %N : i32 -> tensor<1024xi32> loc(#loc)
      %19 = arith.cmpi slt, %15, %18 : tensor<1024xi32> loc(#loc)
      %20 = tt.load %17, %19, %cst : tensor<1024x!tt.ptr<f32>> loc(#loc)
      %21 = arith.addf %sums_0, %20 : tensor<1024xf32> loc(#loc)
      scf.yield %21 : tensor<1024xf32> loc(#loc)
    } loc(#loc7)
    %5 = "tt.reduce"(%sums) <{axis = 0 : i32}> ({
    ^bb0(%arg6: f32 loc(unknown), %arg7: f32 loc(unknown)):
      %13 = arith.addf %arg6, %arg7 : f32 loc(#loc)
      tt.reduce.return %13 : f32 loc(#loc)
    }) : (tensor<1024xf32>) -> f32 loc(#loc)
    %6 = arith.sitofp %N : i32 to f32 loc(#loc)
    %7 = arith.divf %5, %6 : f32 loc(#loc)
    %squares = scf.for %off = %c0_i32 to %N step %c1024_i32 iter_args(%squares_0 = %cst) -> (tensor<1024xf32>)  : i32 {
      %13 = tt.make_range {end = 1024 : i32, start = 0 : i32} : tensor<1024xi32> loc(#loc)
      %14 = tt.splat %off : i32 -> tensor<1024xi32> loc(#loc)
      %15 = arith.addi %14, %13 : tensor<1024xi32> loc(#loc)
      %16 = tt.splat %4 : !tt.ptr<f32> -> tensor<1024x!tt.ptr<f32>> loc(#loc)
      %17 = tt.addptr %16, %15 : tensor<1024x!tt.ptr<f32>>, tensor<1024xi32> loc(#loc)
      %18 = tt.splat %N : i32 -> tensor<1024xi32> loc(#loc)
      %19 = arith.cmpi slt, %15, %18 : tensor<1024xi32> loc(#loc)
      %20 = tt.load %17, %19, %cst : tensor<1024x!tt.ptr<f32>> loc(#loc)
      %21 = tt.splat %7 : f32 -> tensor<1024xf32> loc(#loc)
      %22 = arith.subf %20, %21 : tensor<1024xf32> loc(#loc)
      %23 = arith.select %19, %22, %cst : tensor<1024xi1>, tensor<1024xf32> loc(#loc)
      %24 = arith.mulf %23, %23 : tensor<1024xf32> loc(#loc)
      %25 = arith.addf %squares_0, %24 : tensor<1024xf32> loc(#loc)
      scf.yield %25 : tensor<1024xf32> loc(#loc)
    } loc(#loc8)
    %8 = "tt.reduce"(%squares) <{axis = 0 : i32}> ({
    ^bb0(%arg6: f32 loc(unknown), %arg7: f32 loc(unknown)):
      %13 = arith.addf %arg6, %arg7 : f32 loc(#loc)
      tt.reduce.return %13 : f32 loc(#loc)
    }) : (tensor<1024xf32>) -> f32 loc(#loc)
    %9 = arith.subf %6, %correction : f32 loc(#loc)
    %10 = arith.divf %8, %9 : f32 loc(#loc)
    %11 = tt.addptr %Var, %1 : !tt.ptr<f32>, i64 loc(#loc)
    tt.store %11, %10 : !tt.ptr<f32> loc(#loc)
    %12 = tt.addptr %Mean, %1 : !tt.ptr<f32>, i64 loc(#loc)
    tt.store %12, %7 : !tt.ptr<f32> loc(#loc)
    tt.return loc(#loc)
  } loc(#loc)
} loc(#loc)
#loc7 = loc("sums")
#loc8 = loc("squares")
