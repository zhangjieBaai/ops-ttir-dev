#loc = loc(unknown)
#loc1 = loc("X")
#loc2 = loc("Var")
#loc3 = loc("Mean")
#loc4 = loc("M")
#loc5 = loc("N")
#loc6 = loc("correction")
module {
  tt.func public @var_mean_welford_kernel(%X: !tt.ptr<f32> {tt.divisibility = 16 : i32} loc("X"), %Var: !tt.ptr<f32> {tt.divisibility = 16 : i32} loc("Var"), %Mean: !tt.ptr<f32> {tt.divisibility = 16 : i32} loc("Mean"), %M: i32 loc("M"), %N: i32 loc("N"), %correction: f32 loc("correction")) attributes {noinline = false} {
    %c1024_i32 = arith.constant 1024 : i32 loc(#loc)
    %c0_i32 = arith.constant 0 : i32 loc(#loc)
    %cst = arith.constant dense<0.000000e+00> : tensor<1024xf32> loc(#loc)
    %0 = tt.get_program_id x : i32 loc(#loc)
    %1 = arith.extsi %0 : i32 to i64 loc(#loc)
    %2 = arith.extsi %N : i32 to i64 loc(#loc)
    %3 = arith.muli %1, %2 : i64 loc(#loc)
    %4 = tt.addptr %X, %3 : !tt.ptr<f32>, i64 loc(#loc)
    %5 = tt.addptr %Var, %1 : !tt.ptr<f32>, i64 loc(#loc)
    %6 = tt.addptr %Mean, %1 : !tt.ptr<f32>, i64 loc(#loc)
    %_sum = scf.for %off = %c0_i32 to %N step %c1024_i32 iter_args(%_sum_0 = %cst) -> (tensor<1024xf32>)  : i32 {
      %15 = tt.make_range {end = 1024 : i32, start = 0 : i32} : tensor<1024xi32> loc(#loc)
      %16 = tt.splat %off : i32 -> tensor<1024xi32> loc(#loc)
      %17 = arith.addi %16, %15 : tensor<1024xi32> loc(#loc)
      %18 = tt.splat %N : i32 -> tensor<1024xi32> loc(#loc)
      %19 = arith.cmpi slt, %17, %18 : tensor<1024xi32> loc(#loc)
      %20 = tt.splat %4 : !tt.ptr<f32> -> tensor<1024x!tt.ptr<f32>> loc(#loc)
      %21 = tt.addptr %20, %17 : tensor<1024x!tt.ptr<f32>>, tensor<1024xi32> loc(#loc)
      %22 = tt.load %21, %19, %cst : tensor<1024x!tt.ptr<f32>> loc(#loc)
      %23 = arith.addf %_sum_0, %22 : tensor<1024xf32> loc(#loc)
      scf.yield %23 : tensor<1024xf32> loc(#loc)
    } loc(#loc7)
    %7 = tt.reshape %_sum allow_reorder : tensor<1024xf32> -> tensor<1024xf32> loc(#loc)
    %8 = "tt.reduce"(%7) <{axis = 0 : i32}> ({
    ^bb0(%arg6: f32 loc(unknown), %arg7: f32 loc(unknown)):
      %15 = arith.addf %arg6, %arg7 : f32 loc(#loc)
      tt.reduce.return %15 : f32 loc(#loc)
    }) : (tensor<1024xf32>) -> f32 loc(#loc)
    %9 = arith.sitofp %N : i32 to f32 loc(#loc)
    %10 = arith.divf %8, %9 : f32 loc(#loc)
    %_acc = scf.for %off = %c0_i32 to %N step %c1024_i32 iter_args(%_acc_0 = %cst) -> (tensor<1024xf32>)  : i32 {
      %15 = tt.make_range {end = 1024 : i32, start = 0 : i32} : tensor<1024xi32> loc(#loc)
      %16 = tt.splat %off : i32 -> tensor<1024xi32> loc(#loc)
      %17 = arith.addi %16, %15 : tensor<1024xi32> loc(#loc)
      %18 = tt.splat %N : i32 -> tensor<1024xi32> loc(#loc)
      %19 = arith.cmpi slt, %17, %18 : tensor<1024xi32> loc(#loc)
      %20 = tt.splat %4 : !tt.ptr<f32> -> tensor<1024x!tt.ptr<f32>> loc(#loc)
      %21 = tt.addptr %20, %17 : tensor<1024x!tt.ptr<f32>>, tensor<1024xi32> loc(#loc)
      %22 = tt.load %21, %19, %cst : tensor<1024x!tt.ptr<f32>> loc(#loc)
      %23 = tt.splat %10 : f32 -> tensor<1024xf32> loc(#loc)
      %24 = arith.subf %22, %23 : tensor<1024xf32> loc(#loc)
      %25 = arith.select %19, %24, %cst : tensor<1024xi1>, tensor<1024xf32> loc(#loc)
      %26 = arith.mulf %25, %25 : tensor<1024xf32> loc(#loc)
      %27 = arith.addf %_acc_0, %26 : tensor<1024xf32> loc(#loc)
      scf.yield %27 : tensor<1024xf32> loc(#loc)
    } loc(#loc8)
    %11 = tt.reshape %_acc allow_reorder : tensor<1024xf32> -> tensor<1024xf32> loc(#loc)
    %12 = "tt.reduce"(%11) <{axis = 0 : i32}> ({
    ^bb0(%arg6: f32 loc(unknown), %arg7: f32 loc(unknown)):
      %15 = arith.addf %arg6, %arg7 : f32 loc(#loc)
      tt.reduce.return %15 : f32 loc(#loc)
    }) : (tensor<1024xf32>) -> f32 loc(#loc)
    %13 = arith.subf %9, %correction : f32 loc(#loc)
    %14 = arith.divf %12, %13 : f32 loc(#loc)
    tt.store %6, %10 : !tt.ptr<f32> loc(#loc)
    tt.store %5, %14 : !tt.ptr<f32> loc(#loc)
    tt.return loc(#loc)
  } loc(#loc)
} loc(#loc)
#loc7 = loc("_sum")
#loc8 = loc("_acc")
