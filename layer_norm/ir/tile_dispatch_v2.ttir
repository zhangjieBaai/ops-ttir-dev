              %p3t1_x_18 = tt.load %p3t1_x_17, %p3t1_mask_12, %cst : tensor<8192x!tt.ptr<f16>>
              %p3t1_x_19 = arith.extf %p3t1_x_18 : tensor<8192xf16> to tensor<8192xf32>
              %p3t1_x_hat = tt.splat %mean_5 : f32 -> tensor<8192xf32>
              %p3t1_x_hat_20 = arith.subf %p3t1_x_19, %p3t1_x_hat : tensor<8192xf32>
              %p3t1_x_hat_21 = tt.splat %rstd_9 : f32 -> tensor<8192xf32>
              %p3t1_x_hat_22 = arith.mulf %p3t1_x_hat_20, %p3t1_x_hat_21 : tensor<8192xf32>
              %p3t1_y = arith.extf %p3t1_w_14 : tensor<8192xf16> to tensor<8192xf32>
              %p3t1_y_23 = arith.mulf %p3t1_x_hat_22, %p3t1_y : tensor<8192xf32>
              %p3t1_y_24 = arith.extf %p3t1_b_16 : tensor<8192xf16> to tensor<8192xf32>
              %p3t1_y_25 = arith.addf %p3t1_y_23, %p3t1_y_24 : tensor<8192xf32>
              %p3t1_2 = tt.splat %Y_2 : !tt.ptr<f16> -> tensor<8192x!tt.ptr<f16>>
              %p3t1_3 = tt.addptr %p3t1_2, %p3t1_cols_11 : tensor<8192x!tt.ptr<f16>>, tensor<8192xi32>
              %p3t1_4 = arith.truncf %p3t1_y_25 : tensor<8192xf32> to tensor<8192xf16>
              tt.store %p3t1_3, %p3t1_4, %p3t1_mask_12 : tensor<8192x!tt.ptr<f16>>
            } else {
              %row = tt.get_program_id x : i32
              %Y_1 = arith.muli %row, %stride : i32
              %Y_2 = tt.addptr %Y, %Y_1 : !tt.ptr<f16>, i32
              %X_3 = tt.addptr %X, %Y_1 : !tt.ptr<f16>, i32
              %_mean = scf.for %off = %c0_i32 to %N step %c8192_i32 iter_args(%_mean_10 = %cst_0) -> (tensor<8192xf32>)  : i32 {
                %cols = tt.make_range {end = 8192 : i32, start = 0 : i32} : tensor<8192xi32>
                %cols_11 = tt.splat %off : i32 -> tensor<8192xi32>
                %cols_12 = arith.addi %cols_11, %cols : tensor<8192xi32>
                %a = tt.splat %N : i32 -> tensor<8192xi32>
                %a_13 = arith.cmpi slt, %cols_12, %a : tensor<8192xi32>
                %a_14 = tt.splat %X_3 : !tt.ptr<f16> -> tensor<8192x!tt.ptr<f16>>
                %a_15 = tt.addptr %a_14, %cols_12 : tensor<8192x!tt.ptr<f16>>, tensor<8192xi32>
                %a_16 = tt.load %a_15, %a_13, %cst : tensor<8192x!tt.ptr<f16>>
                %a_17 = arith.extf %a_16 : tensor<8192xf16> to tensor<8192xf32>
                %_mean_18 = arith.addf %_mean_10, %a_17 : tensor<8192xf32>
                scf.yield %_mean_18 : tensor<8192xf32>
              }
              %mean = "tt.reduce"(%_mean) <{axis = 0 : i32}> ({
              ^bb0(%mean_10: f32, %mean_11: f32):
                %mean_12 = arith.addf %mean_10, %mean_11 : f32
                tt.reduce.return %mean_12 : f32
              }) : (tensor<8192xf32>) -> f32
              %mean_4 = arith.sitofp %N : i32 to f32
              %mean_5 = arith.divf %mean, %mean_4 : f32
              %_var = scf.for %off = %c0_i32 to %N step %c8192_i32 iter_args(%_var_10 = %cst_0) -> (tensor<8192xf32>)  : i32 {
                %cols = tt.make_range {end = 8192 : i32, start = 0 : i32} : tensor<8192xi32>
                %cols_11 = tt.splat %off : i32 -> tensor<8192xi32>
                %cols_12 = arith.addi %cols_11, %cols : tensor<8192xi32>
                %x = tt.splat %N : i32 -> tensor<8192xi32>
                %x_13 = arith.cmpi slt, %cols_12, %x : tensor<8192xi32>
                %x_14 = tt.splat %X_3 : !tt.ptr<f16> -> tensor<8192x!tt.ptr<f16>>
                %x_15 = tt.addptr %x_14, %cols_12 : tensor<8192x!tt.ptr<f16>>, tensor<8192xi32>
                %x_16 = tt.load %x_15, %x_13, %cst : tensor<8192x!tt.ptr<f16>>
                %x_17 = arith.extf %x_16 : tensor<8192xf16> to tensor<8192xf32>
                %x_18 = tt.splat %mean_5 : f32 -> tensor<8192xf32>
                %x_19 = arith.subf %x_17, %x_18 : tensor<8192xf32>
                %x_20 = arith.select %x_13, %x_19, %cst_0 : tensor<8192xi1>, tensor<8192xf32>
                %_var_21 = arith.mulf %x_20, %x_20 : tensor<8192xf32>
                %_var_22 = arith.addf %_var_10, %_var_21 : tensor<8192xf32>
                scf.yield %_var_22 : tensor<8192xf32>
              }
              %var = "tt.reduce"(%_var) <{axis = 0 : i32}> ({
              ^bb0(%var_10: f32, %var_11: f32):
                %var_12 = arith.addf %var_10, %var_11 : f32
                tt.reduce.return %var_12 : f32
              }) : (tensor<8192xf32>) -> f32
              %var_6 = arith.divf %var, %mean_4 : f32
              %rstd_7 = arith.addf %var_6, %eps : f32
              %rstd_8 = math.sqrt %rstd_7 : f32
              %rstd_9 = arith.divf %rstd, %rstd_8 : f32
              %0 = tt.addptr %Mean, %row : !tt.ptr<f32>, i32
              tt.store %0, %mean_5 : !tt.ptr<f32>
              %1 = tt.addptr %Rstd, %row : !tt.ptr<f32>, i32
              tt.store %1, %rstd_9 : !tt.ptr<f32>
              scf.for %off = %c0_i32 to %N step %c8192_i32  : i32 {
                %cols = tt.make_range {end = 8192 : i32, start = 0 : i32} : tensor<8192xi32>
                %cols_10 = tt.splat %off : i32 -> tensor<8192xi32>
                %cols_11 = arith.addi %cols_10, %cols : tensor<8192xi32>
                %mask = tt.splat %N : i32 -> tensor<8192xi32>
                %mask_12 = arith.cmpi slt, %cols_11, %mask : tensor<8192xi32>
                %w = tt.splat %W : !tt.ptr<f16> -> tensor<8192x!tt.ptr<f16>>
                %w_13 = tt.addptr %w, %cols_11 : tensor<8192x!tt.ptr<f16>>, tensor<8192xi32>
                %w_14 = tt.load %w_13, %mask_12 : tensor<8192x!tt.ptr<f16>>
                %b = tt.splat %B : !tt.ptr<f16> -> tensor<8192x!tt.ptr<f16>>
                %b_15 = tt.addptr %b, %cols_11 : tensor<8192x!tt.ptr<f16>>, tensor<8192xi32>
                %b_16 = tt.load %b_15, %mask_12 : tensor<8192x!tt.ptr<f16>>
                %x = tt.splat %X_3 : !tt.ptr<f16> -> tensor<8192x!tt.ptr<f16>>
                %x_17 = tt.addptr %x, %cols_11 : tensor<8192x!tt.ptr<f16>>, tensor<8192xi32>
                %x_18 = tt.load %x_17, %mask_12, %cst : tensor<8192x!tt.ptr<f16>>
                %x_19 = arith.extf %x_18 : tensor<8192xf16> to tensor<8192xf32>
                %x_hat = tt.splat %mean_5 : f32 -> tensor<8192xf32>
                %x_hat_20 = arith.subf %x_19, %x_hat : tensor<8192xf32>
                %x_hat_21 = tt.splat %rstd_9 : f32 -> tensor<8192xf32>
                %x_hat_22 = arith.mulf %x_hat_20, %x_hat_21 : tensor<8192xf32>
                %y = arith.extf %w_14 : tensor<8192xf16> to tensor<8192xf32>
                %y_23 = arith.mulf %x_hat_22, %y : tensor<8192xf32>
                %y_24 = arith.extf %b_16 : tensor<8192xf16> to tensor<8192xf32>
                %y_25 = arith.addf %y_23, %y_24 : tensor<8192xf32>
                %2 = tt.splat %Y_2 : !tt.ptr<f16> -> tensor<8192x!tt.ptr<f16>>
                %3 = tt.addptr %2, %cols_11 : tensor<8192x!tt.ptr<f16>>, tensor<8192xi32>
                %4 = arith.truncf %y_25 : tensor<8192xf32> to tensor<8192xf16>
                tt.store %3, %4, %mask_12 : tensor<8192x!tt.ptr<f16>>
              }
            }
          }
        }
      }
    }
    tt.return
  }
}
